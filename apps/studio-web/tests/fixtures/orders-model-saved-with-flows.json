      "name": "Payments",
      "parent": "finance"
    },
    {
      "id": "payment-service",
      "type": "service",
      "name": "Payment Service",
      "parent": "payments",
      "evidence": "services/payments/src/handler.ts"
    },
    {
      "id": "billing-service",
      "type": "service",
      "name": "Billing Service",
      "parent": "payments"
    },
    {
      "id": "PlaceOrder",
      "type": "command",
      "name": "Place Order"
    },
    {
      "id": "OrderPlaced",
      "type": "event",
      "name": "Order Placed",
      "summary": "An order was accepted",
      "evidence": "specs/orders.asyncapi.yaml",
      "url": "https://github.com/example/shop/blob/main/specs/orders.asyncapi.yaml#L42",
      "schema": {
        "format": "avro",
        "path": "schemas/OrderPlaced.avsc",
        "content": "{\n  \"type\": \"record\",\n  \"name\": \"OrderPlaced\",\n  \"namespace\": \"com.shop.orders\",\n  \"fields\": [\n    {\n      \"name\": \"orderId\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"customerId\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"total\",\n      \"type\": {\n        \"type\": \"bytes\",\n        \"logicalType\": \"decimal\",\n        \"precision\": 10,\n        \"scale\": 2\n      }\n    },\n    {\n      \"name\": \"placedAt\",\n      \"type\": {\n        \"type\": \"long\",\n        \"logicalType\": \"timestamp-millis\"\n      }\n    }\n  ]\n}"
      }
    },
    {
      "id": "PaymentProcessed",
      "type": "event",
      "name": "Payment Processed"
    },
    {
      "id": "orders-topic",
      "type": "channel",
      "name": "orders",
      "technology": "Kafka"
    },
    {
      "id": "payments-topic",
      "type": "channel",
      "name": "payments",
      "technology": "Kafka"
    },
    {
      "id": "orders-db",
      "type": "container",
      "name": "Orders DB",
      "technology": "PostgreSQL"
    },
    {
      "id": "logistics",
      "type": "domain",
      "name": "Logistics"
    },
    {
      "id": "shipping-service",
      "type": "service",
      "name": "Shipping Service",
      "parent": "logistics"
    },
    {
      "id": "OrderShipped",
      "type": "event",
      "name": "Order Shipped"
    }
  ],
  "relations": [
    {
      "from": "orders-service",
      "to": "PlaceOrder",
      "kind": "receives"
    },
    {
      "from": "orders-service",
      "to": "OrderPlaced",
      "kind": "sends",
      "evidence": "services/orders/src/publish.ts:12"
    },
    {
      "from": "OrderPlaced",
      "to": "orders-topic",
      "kind": "routes-through"
    },
    {
      "from": "payment-service",
      "to": "OrderPlaced",
      "kind": "receives"
    },
    {
      "from": "inventory-service",
      "to": "OrderPlaced",
      "kind": "receives",
      "inferred": true
    },
    {
      "from": "payment-service",
      "to": "PaymentProcessed",
      "kind": "sends"
    },
    {
      "from": "PaymentProcessed",
      "to": "payments-topic",
      "kind": "routes-through"
    },
    {
      "from": "orders-service",
      "to": "PaymentProcessed",
      "kind": "receives"
    },
    {
      "from": "billing-service",
      "to": "PaymentProcessed",
      "kind": "receives",
      "inferred": true
    },
    {
      "from": "orders-service",
      "to": "orders-db",
      "kind": "writes"
    },
    {
      "from": "orders-service",
      "to": "orders-db",
      "kind": "reads"
    },
    {
      "from": "shipping-service",
      "to": "OrderPlaced",
      "kind": "receives"
    },
    {
      "from": "shipping-service",
      "to": "OrderShipped",
      "kind": "sends"
    },
    {
      "from": "orders-service",
      "to": "OrderShipped",
      "kind": "receives",
      "inferred": true
    }
  ],
  "flows": [
    {
      "name": "Customer places an order",
      "summary": "From the storefront to a paid order",
      "steps": [
        {
          "resource": "PlaceOrder",
          "text": "The storefront sends PlaceOrder"
        },
        {
          "resource": "orders-service",
          "text": "Orders Service saves the order in Orders DB"
        },
        {
          "resource": "OrderPlaced",
          "text": "Orders Service publishes OrderPlaced to the orders topic"
        },
        {
          "resource": "payment-service",
          "text": "Payment Service takes the payment"
        },
        {
          "resource": "PaymentProcessed",
          "text": "Payment Service publishes PaymentProcessed"
        },
        {
          "resource": "orders-service",
          "text": "Orders Service marks the order as paid"
        }
      ]
    },
    {
      "name": "Order is shipped",
      "summary": "After payment, logistics takes over",
      "steps": [
        {
          "resource": "shipping-service",
          "text": "Shipping Service receives OrderPlaced and books a courier"
        },
        {
          "resource": "OrderShipped",
          "text": "Shipping Service publishes OrderShipped"
        },
        {
          "resource": "orders-service",
          "text": "Orders Service updates the order status"
        }
      ]
    }
  ],
  "notes": [
    {
      "resource": "billing-service",
      "text": "Billing reads PaymentProcessed but we could not find the consumer code.",
      "author": "Agent"
    }
  ]
}