{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@config": ["src/utils/eventcatalog-config/source.ts"],
      "@eventcatalog": ["src/utils/eventcatalog-config/catalog.ts"],
      "@icons/*": ["src/icons/*"],
      "@components/*": ["src/components/*"],
      "@catalog/layouts/*": ["src/toolkit/layouts/*"],
      "@catalog/utils": ["src/toolkit/utils/index.ts"],
      "@catalog/utils/*": ["src/toolkit/utils/*"],
      "@types": ["src/types/index.ts"],
      "@utils/*": ["src/utils/*"],
      "@layouts/*": ["src/layouts/*"],
      "@features/*": ["src/features/*"],
      "auth:config": ["./auth.config.ts"],
      "@stores/*": ["src/stores/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*", "*.config.*"],
  "exclude": ["src/custom-pages"]
}
