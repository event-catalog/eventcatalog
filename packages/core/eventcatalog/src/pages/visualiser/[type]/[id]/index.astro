---
import Seo from '@components/Seo.astro';
import { buildUrl } from '@utils/url-builder';
import { isSSR } from '@utils/feature';
import { findVisualiserResource, getVisualiserResources } from './_index.data';

export const prerender = !isSSR();

export async function getStaticPaths() {
  const resources = await getVisualiserResources();
  return resources.map(({ type, item }) => ({ params: { type, id: item.data.id }, props: item }));
}

// A static build gets the resource from getStaticPaths; a server, which has no static paths, looks it up
const resource = isSSR() ? await findVisualiserResource(Astro.params.type, Astro.params.id) : Astro.props;

if (!resource?.data) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const pageTitle = `${resource.collection} | ${resource.data.name}`.replace(/^\w/, (c) => c.toUpperCase());
const redirectUrl = buildUrl(`${Astro.url.pathname.replace(/\/$/, '')}/${resource.data.latestVersion}`, false, true);

// A server redirects straight away (with any query string); a static page redirects in the browser
if (isSSR()) {
  return Astro.redirect(`${redirectUrl}${Astro.url.search}`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={pageTitle} />
  </head>
  <body>
    <p>You are being redirected to <a href={redirectUrl}>{redirectUrl}</a></p>
  </body>
</html>

<script define:vars={{ redirectUrl }}>
  document.addEventListener('DOMContentLoaded', () => {
    // redirect with any search params too
    const searchParams = window.location.search;
    const fullRedirectUrl = redirectUrl + searchParams;
    window.location.href = fullRedirectUrl;
  });
</script>
