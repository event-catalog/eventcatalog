---
import ChangelogPage from './_ChangelogPage.astro';
import { Page } from './_index.data';

export const prerender = Page.prerender;
export const getStaticPaths = Page.getStaticPaths;

const changelogOwner = await Page.getData(Astro);
if (!changelogOwner) return Astro.rewrite('/404');
---

<ChangelogPage changelogOwner={changelogOwner} />
