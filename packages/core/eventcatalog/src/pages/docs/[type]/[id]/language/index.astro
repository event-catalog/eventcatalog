---
import VerticalSideBarLayout from '@layouts/VerticalSideBarLayout.astro';
import { getUbiquitousLanguageWithSubdomains } from '@utils/collections/domains';
import { buildUrl } from '@utils/url-builder';
import DocsBreadcrumb from '@components/DocsBreadcrumb.astro';
import { ClientRouter } from 'astro:transitions';
import * as LucideIcons from 'lucide-react';

import { Page } from './_index.data';

export const prerender = Page.prerender;
export const getStaticPaths = Page.getStaticPaths;

// Get data
const props = await Page.getData(Astro);
if (!props) return Astro.rewrite('/404');

const pageTitle = `${props.collection} | ${props.data.name}`.replace(/^\w/, (c) => c.toUpperCase());
const ubiquitousLanguageData = await getUbiquitousLanguageWithSubdomains(props);
const ubiquitousLanguage = ubiquitousLanguageData.domain;
const { subdomains, duplicateTerms } = ubiquitousLanguageData;

const termCount =
  (ubiquitousLanguage?.data.dictionary?.length ?? 0) +
  subdomains.reduce((total, subdomain: any) => total + (subdomain.ubiquitousLanguage?.data.dictionary?.length ?? 0), 0);
const ownerTypeLabel = props.collection === 'domains' ? 'Domain' : 'System';

// The glossary: each language's terms under their first letter (A–Z, then # for anything else), alphabetical within
type Term = { id: string; name: string; summary?: string };
const letterOf = (name: string) => {
  const first = name.trim().charAt(0).toUpperCase();
  return /[A-Z]/.test(first) ? first : '#';
};
const groupByLetter = (terms: Term[] = []) => {
  const groups = new Map<string, Term[]>();
  [...terms]
    .sort((a, b) => a.name.localeCompare(b.name))
    .forEach((term) => {
      const letter = letterOf(term.name);
      groups.set(letter, [...(groups.get(letter) ?? []), term]);
    });
  return [...groups.entries()].sort(([a], [b]) => (a === '#' ? 1 : b === '#' ? -1 : a.localeCompare(b)));
};

// One glossary for this domain's own terms, then one for each subdomain that has a language
const sections = [
  ...(ubiquitousLanguage && (ubiquitousLanguage.data.dictionary?.length ?? 0) > 0
    ? [
        {
          id: 'main',
          name: props.data.name,
          href: undefined as string | undefined,
          termBase: `/docs/${props.collection}/${props.data.id}/language`,
          letters: groupByLetter(ubiquitousLanguage.data.dictionary as Term[]),
        },
      ]
    : []),
  ...subdomains
    .filter((s: any) => (s.ubiquitousLanguage?.data.dictionary?.length ?? 0) > 0)
    .map(({ subdomain, ubiquitousLanguage: subdomainUL }: any) => ({
      id: subdomain.data.id as string,
      name: subdomain.data.name as string,
      href: buildUrl(`/docs/domains/${subdomain.data.id}/${subdomain.data.version}`),
      termBase: `/docs/${props.collection}/${subdomain.data.id}/language`,
      letters: groupByLetter(subdomainUL.data.dictionary as Term[]),
    })),
];
const showSectionHeadings = sections.length > 1;
const ALPHABET = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', '#'];
const usedLetters = new Set(sections.flatMap((section) => section.letters.map(([letter]) => letter)));
// Each letter group's anchor, unique per glossary; a letter in the alphabet jumps to the first glossary that has it
// (and, while searching, to the first one still showing it)
const letterAnchor = (sectionId: string, letter: string) => `letter-${sectionId}-${letter === '#' ? 'other' : letter}`;
const firstAnchorFor = new Map<string, string>();
sections.forEach((section) =>
  section.letters.forEach(([letter]) => {
    if (!firstAnchorFor.has(letter)) firstAnchorFor.set(letter, letterAnchor(section.id, letter));
  })
);
---

<VerticalSideBarLayout title={pageTitle} description={props.data.summary}>
  <main
    class="flex docs-layout min-h-full bg-[rgb(var(--ec-page-bg))]"
    data-pagefind-body
    data-pagefind-meta={`title:${pageTitle}`}
  >
    <div class="flex docs-layout w-full">
      <div class="w-full min-w-0 lg:mr-2 xl:pr-[42px] pt-5 pb-8 min-h-[50em]">
        {/* Header mirrors the resource page (docs/[type]/[id]/[version]/index.astro). */}
        <div class="border-b border-[rgb(var(--ec-page-border))] md:pb-3 pt-2">
          <div class="flex flex-col gap-4">
            <DocsBreadcrumb
              collection={props.collection}
              items={[
                {
                  label: props.data.name,
                  href: buildUrl(`/docs/${props.collection}/${props.data.id}/${props.data.latestVersion ?? props.data.version}`),
                },
                { label: 'Ubiquitous Language' },
              ]}
            />
            <h1 id="doc-page-header" class="text-[28px] md:text-[34px] font-semibold leading-tight tracking-[-0.025em] text-[rgb(var(--ec-page-text))]">
              Ubiquitous Language
            </h1>
          </div>
          <p class="ec-docs-summary">
            {termCount} {termCount === 1 ? 'term' : 'terms'} used in the {props.data.name} {ownerTypeLabel.toLowerCase()}{
              subdomains.length > 0 ? ' and its subdomains' : ''
            }.
          </p>
        </div>

        {
          termCount > 0 && (
            <div class="pt-6">
              {/* The alphabet: letters with terms jump to them, the rest stay greyed out */}
              <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
                <nav aria-label="Jump to letter" class="flex flex-wrap gap-0.5" data-alphabet>
                  {ALPHABET.map((letter) =>
                    usedLetters.has(letter) ? (
                      <a
                        href={`#${firstAnchorFor.get(letter)}`}
                        data-letter-link={letter}
                        class="flex h-7 w-7 items-center justify-center rounded-md text-xs font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:bg-[rgb(var(--ec-page-text)/0.06)]"
                      >
                        {letter}
                      </a>
                    ) : (
                      <span
                        aria-hidden="true"
                        class="flex h-7 w-7 items-center justify-center text-xs text-[rgb(var(--ec-page-text-muted)/0.45)]"
                      >
                        {letter}
                      </span>
                    )
                  )}
                </nav>
                <div class="relative w-full sm:w-64">
                  <svg
                    class="pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[rgb(var(--ec-page-text-muted))]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                  <input
                    type="text"
                    id="searchInput"
                    placeholder="Search terms..."
                    autocomplete="off"
                    class="h-8 w-full rounded-md border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-text)/0.025)] pl-8 pr-3 text-[13px] text-[rgb(var(--ec-page-text))] outline-none transition-[border-color,box-shadow] placeholder:text-[rgb(var(--ec-page-text-muted))] hover:border-[rgb(var(--ec-page-text)/0.2)] focus:border-[rgb(var(--ec-page-text)/0.3)] focus:shadow-[0_0_0_3px_rgb(var(--ec-page-text)/0.06)]"
                  />
                </div>
              </div>

              {/* Each language: an optional heading (when there are subdomains), then its letters */}
              <div class="mt-6 flex flex-col gap-12">
                {sections.map((section) => (
                  <section data-domain-section={section.id}>
                    {showSectionHeadings && (
                      <div class="mb-2 flex items-baseline justify-between gap-4">
                        <h2 class="text-[17px] font-semibold text-[rgb(var(--ec-page-text))]">
                          {section.name}
                          <span class="ml-2 text-sm font-normal text-[rgb(var(--ec-page-text-muted))]">
                            {section.letters.reduce((total, [, terms]) => total + terms.length, 0)} terms
                          </span>
                        </h2>
                        {section.href && (
                          <a
                            href={section.href}
                            class="text-[13px] text-[rgb(var(--ec-page-text-muted))] transition-colors hover:text-[rgb(var(--ec-page-text))]"
                          >
                            View domain →
                          </a>
                        )}
                      </div>
                    )}
                    {section.letters.map(([letter, terms]) => (
                      <div
                        id={letterAnchor(section.id, letter)}
                        data-letter-group={letter}
                        class="grid scroll-mt-[calc(var(--ec-header-offset,60px)+1rem)] grid-cols-[2.5rem_minmax(0,1fr)] gap-4 border-t border-[rgb(var(--ec-page-border))] py-5 sm:grid-cols-[3.5rem_minmax(0,1fr)]"
                      >
                        <span class="text-[22px] font-semibold leading-none text-[rgb(var(--ec-page-text-muted)/0.5)]">{letter}</span>
                        <div class="flex flex-col gap-4">
                          {terms.map((term) => (
                            <a
                              href={buildUrl(`${section.termBase}/${term.id}`)}
                              class="term-card group block rounded-md"
                              data-term-name={term.name}
                              data-domain={section.id}
                            >
                              <span class="flex items-center gap-2">
                                <span class="text-[15px] font-semibold text-[rgb(var(--ec-page-text))] group-hover:underline group-hover:underline-offset-4">
                                  {term.name}
                                </span>
                                {duplicateTerms.has(term.name.toLowerCase()) && (
                                  <span
                                    class="inline-flex h-5 items-center rounded border border-[rgb(var(--ec-badge-color-amber-text)/0.3)] px-1.5 text-[11px] font-medium text-[rgb(var(--ec-badge-color-amber-text))]"
                                    title="This term is also defined in another domain on this page"
                                  >
                                    Also defined elsewhere
                                  </span>
                                )}
                              </span>
                              {term.summary && (
                                <span class="summary-text mt-1 block max-w-[72ch] text-sm leading-relaxed text-[rgb(var(--ec-page-text-muted))]">
                                  {term.summary}
                                </span>
                              )}
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                    <p class="hidden border-t border-[rgb(var(--ec-page-border))] py-8 text-sm text-[rgb(var(--ec-page-text-muted))]" data-domain-no-results={section.id}>
                      No terms in {section.name} match your search.
                    </p>
                  </section>
                ))}
              </div>
            </div>
          )
        }

        {
          termCount === 0 && (
            <div class="flex flex-col items-center justify-center py-16 px-4">
              <div class="flex items-center justify-center w-12 h-12 rounded-full border border-[rgb(var(--ec-page-border))] mb-4">
                {(() => {
                  const BookOpen = LucideIcons.BookOpen;
                  //@ts-ignore
                  return <BookOpen className="w-5 h-5 text-[rgb(var(--ec-page-text-muted))]" />;
                })()}
              </div>
              <h3 class="text-base font-medium text-[rgb(var(--ec-page-text))] mb-1">No ubiquitous language defined</h3>
              <p class="text-sm text-[rgb(var(--ec-page-text-muted))] text-center max-w-md">
                This {ownerTypeLabel.toLowerCase()} has no ubiquitous language terms yet. Adding some helps everyone share a common
                vocabulary.
              </p>
            </div>
          )
        }
      </div>
    </div>
    <ClientRouter />
  </main>

  <script>
    // Search narrows every glossary by term name and summary: terms that don't match hide, letters left empty hide,
    // and each letter in the alphabet points at the first group still showing it (or turns off when none does)
    function initializeSearch() {
      const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
      const sections = document.querySelectorAll('[data-domain-section]');

      function updateResults() {
        const query = searchInput?.value.trim().toLowerCase() || '';
        const firstVisibleGroup = new Map<string, string>();

        sections.forEach((section) => {
          const id = section.getAttribute('data-domain-section');
          let sectionVisible = 0;
          section.querySelectorAll<HTMLElement>('[data-letter-group]').forEach((group) => {
            let groupVisible = 0;
            group.querySelectorAll<HTMLElement>('.term-card').forEach((card) => {
              const text = `${card.dataset.termName || ''} ${card.querySelector('.summary-text')?.textContent || ''}`.toLowerCase();
              const matches = query === '' || text.includes(query);
              card.classList.toggle('hidden', !matches);
              if (matches) groupVisible++;
            });
            group.classList.toggle('hidden', groupVisible === 0);
            const letter = group.dataset.letterGroup || '';
            if (groupVisible > 0 && !firstVisibleGroup.has(letter)) firstVisibleGroup.set(letter, group.id);
            sectionVisible += groupVisible;
          });
          section.querySelector(`[data-domain-no-results="${id}"]`)?.classList.toggle('hidden', query === '' || sectionVisible > 0);
        });

        document.querySelectorAll<HTMLAnchorElement>('[data-letter-link]').forEach((link) => {
          const target = firstVisibleGroup.get(link.dataset.letterLink || '');
          if (target) {
            link.href = `#${target}`;
            link.removeAttribute('aria-disabled');
            link.removeAttribute('tabindex');
            link.style.opacity = '';
            link.style.pointerEvents = '';
          } else {
            link.setAttribute('aria-disabled', 'true');
            link.setAttribute('tabindex', '-1');
            link.style.opacity = '0.35';
            link.style.pointerEvents = 'none';
          }
        });
      }

      searchInput?.addEventListener('input', updateResults);
      updateResults();
    }

    document.addEventListener('astro:page-load', initializeSearch);
  </script>
</VerticalSideBarLayout>
