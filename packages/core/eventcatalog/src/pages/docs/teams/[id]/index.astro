---
import components from '@components/MDX/components';

import { render } from 'astro:content';
import EnvelopeIcon from '@heroicons/react/16/solid/EnvelopeIcon';
import { Github } from 'lucide-react';
import { buildUrl } from '@utils/url-builder';
import { getTeamMemberIds } from '@utils/collections/teams';
import { getUsers } from '@utils/collections/users';
import VerticalSideBarLayout from '@layouts/VerticalSideBarLayout.astro';
import OnThisPage from '@components/OnThisPage.astro';
import OwnedResourceStats from '@components/OwnedResourceStats.astro';
import { Page } from './_index.data';

export const prerender = Page.prerender;
export const getStaticPaths = Page.getStaticPaths;

// Get data
const props = await Page.getData(Astro);
if (!props) return Astro.rewrite('/404');

const { Content, headings } = await render(props);

// Members that are in the catalog, as the sidebar's Members section lists them.
const userIds = new Set((await getUsers()).map((user) => user.data.id));
const memberCount = getTeamMemberIds(props, userIds).length;

const pageTitle = `Team | ${props.data.name}`;
const source = props.data.source;
const sourceLabels: Record<string, string> = {
  github: 'GitHub',
  'microsoft-entra': 'Microsoft Entra ID',
};
const sourceLabel = source?.provider ? (sourceLabels[source.provider] ?? source.provider) : undefined;
const sourceTitle = sourceLabel ? `Synced from ${sourceLabel}` : undefined;
---

<VerticalSideBarLayout title={pageTitle} description={props.data.summary}>
  <main
    class="flex docs-layout min-h-full bg-[rgb(var(--ec-page-bg))]"
    data-pagefind-body
    data-pagefind-meta={`title:${pageTitle}`}
  >
    <div class="flex docs-layout w-full">
      <div class="w-full min-w-0 lg:mr-2 xl:pr-12 py-8 bg-[rgb(var(--ec-page-bg))]">
        <div class="border-b border-[rgb(var(--ec-page-border))] pb-6">
          <div class="flex justify-start">
            <div class="flex flex-col justify-between space-y-3">
              <div>
                <h2 class="text-3xl font-bold text-[rgb(var(--ec-page-text))]">{props.data.name}</h2>
              </div>
              {
                props.data.summary && (
                  <p class="text-base text-[rgb(var(--ec-page-text-muted))] max-w-2xl">{props.data.summary}</p>
                )
              }
              <div class="flex flex-wrap gap-3 pt-1">
                {
                  props.data.email && (
                    <a
                      href={`mailto:${props.data.email}`}
                      class="inline-flex items-center gap-1.5 text-sm text-[rgb(var(--ec-page-text-muted))] hover:text-[rgb(var(--ec-page-text))] transition-colors"
                    >
                      <EnvelopeIcon className="w-4 h-4 text-[rgb(var(--ec-icon-color))]" />
                      <span>Email</span>
                    </a>
                  )
                }
                {
                  props.data.slackDirectMessageUrl && (
                    <a
                      href={props.data.slackDirectMessageUrl}
                      class="inline-flex items-center gap-1.5 text-sm text-[rgb(var(--ec-page-text-muted))] hover:text-[rgb(var(--ec-page-text))] transition-colors"
                    >
                      <img src={buildUrl('/slack-icon.svg', true)} class="w-4 h-4" alt="Slack" />
                      <span>Slack</span>
                    </a>
                  )
                }
                {
                  props.data.msTeamsDirectMessageUrl && (
                    <a
                      href={props.data.msTeamsDirectMessageUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm text-[rgb(var(--ec-page-text-muted))] hover:text-[rgb(var(--ec-page-text))] transition-colors"
                    >
                      <img src={buildUrl('/icons/ms-teams.svg', true)} class="w-4 h-4" alt="Teams" />
                      <span>Teams</span>
                    </a>
                  )
                }
                {
                  source && sourceLabel && source.url && (
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={sourceTitle}
                      class="inline-flex items-center gap-1.5 text-sm text-[rgb(var(--ec-page-text-muted))] hover:text-[rgb(var(--ec-page-text))] transition-colors"
                    >
                      {source.provider === 'github' && <Github className="w-4 h-4 text-[rgb(var(--ec-icon-color))]" />}
                      {source.provider === 'microsoft-entra' && <img src={buildUrl('/icons/azure.svg', true)} class="w-4 h-4" alt="" />}
                      <span>{sourceLabel}</span>
                    </a>
                  )
                }
                {
                  source && sourceLabel && !source.url && (
                    <span
                      title={sourceTitle}
                      class="inline-flex items-center gap-1.5 text-sm text-[rgb(var(--ec-page-text-muted))]"
                    >
                      {source.provider === 'github' && <Github className="w-4 h-4 text-[rgb(var(--ec-icon-color))]" />}
                      {source.provider === 'microsoft-entra' && <img src={buildUrl('/icons/azure.svg', true)} class="w-4 h-4" alt="" />}
                      <span>{sourceLabel}</span>
                    </span>
                  )
                }
              </div>
            </div>
          </div>
          <div class="pt-4">
            <OwnedResourceStats
              owner={props}
              resourcesHref={buildUrl(`/docs/teams/${props.data.id}/resources`)}
              people={{ label: 'Members', count: memberCount }}
            />
          </div>
        </div>
        <div class="prose prose-md py-4 w-full">
          <Content components={components(props)} />
        </div>
      </div>
      <aside
        class="hidden xl:block sticky top-[4rem] self-start w-[280px] max-h-[calc(100vh-4rem)] overflow-y-auto py-2 flex-shrink-0 pr-4 bg-[rgb(var(--ec-page-bg))]"
        data-pagefind-ignore
      >
        <div class="mt-8 space-y-8">
          <OnThisPage headings={headings} />
        </div>
      </aside>
    </div>
  </main>
</VerticalSideBarLayout>

<style>
  .docs-layout .prose {
    max-width: none;
  }
</style>
