---
import components from '@components/MDX/components';

import { render } from 'astro:content';
import { Github } from 'lucide-react';
import { buildUrl } from '@utils/url-builder';
import VerticalSideBarLayout from '@layouts/VerticalSideBarLayout.astro';
import OnThisPage from '@components/OnThisPage.astro';
import DocsBreadcrumb from '@components/DocsBreadcrumb.astro';
import { Page } from './_index.data';

export const prerender = Page.prerender;
export const getStaticPaths = Page.getStaticPaths;

// Get data
const props = await Page.getData(Astro);
if (!props) return Astro.rewrite('/404');

const { Content, headings } = await render(props);


const pageTitle = `Team | ${props.data.name}`;
const source = props.data.source;
const sourceLabels: Record<string, string> = {
  github: 'GitHub',
  'microsoft-entra': 'Microsoft Entra ID',
};
const sourceLabel = source?.provider ? (sourceLabels[source.provider] ?? source.provider) : undefined;
const sourceTitle = sourceLabel ? `Synced from ${sourceLabel}` : undefined;
---

<VerticalSideBarLayout title={pageTitle} description={props.data.summary}>
  <main
    class="flex docs-layout min-h-full bg-[rgb(var(--ec-page-bg))]"
    data-pagefind-body
    data-pagefind-meta={`title:${pageTitle}`}
  >
    <div class="flex docs-layout w-full">
      <div class="w-full min-w-0 lg:mr-2 xl:pr-[42px] pt-5 pb-8 bg-[rgb(var(--ec-page-bg))]">
        {/* As the docs pages: Teams / Customer Platform / Overview, then the title and summary (what they own is in Owned Resources). Contact
            details live in the sidebar, so they are not repeated here */}
        <div class="border-b border-[rgb(var(--ec-page-border))] pt-2 pb-6">
          <div class="flex flex-col gap-3">
            <DocsBreadcrumb collection="teams" items={[{ label: props.data.name, href: buildUrl(`/docs/teams/${props.data.id}`) }, { label: 'Overview' }]} />
            <div>
              <h2 class="text-[28px] md:text-[34px] font-semibold leading-tight tracking-[-0.025em] text-[rgb(var(--ec-page-text))]">
                {props.data.name}
              </h2>
              {props.data.summary && <p class="ec-docs-summary">{props.data.summary}</p>}
            {
              source && sourceLabel && (
                <p class="mt-3 inline-flex items-center gap-1.5 text-[13px] text-[rgb(var(--ec-page-text-muted))]" title={sourceTitle}>
                  {source.provider === 'github' && <Github className="h-3.5 w-3.5" />}
                  {source.provider === 'microsoft-entra' && <img src={buildUrl('/icons/azure.svg', true)} class="ec-mono-icon h-3.5 w-3.5" alt="" />}
                  {source.url ? (
                    <a href={source.url} target="_blank" rel="noopener noreferrer" class="hover:text-[rgb(var(--ec-page-text))] hover:underline">
                      {sourceTitle}
                    </a>
                  ) : (
                    <span>{sourceTitle}</span>
                  )}
                </p>
              )
            }
            </div>
          </div>
        </div>
        <div class="prose prose-md pt-8 pb-4 w-full text-[15px]">
          <Content components={components(props)} />
        </div>
      </div>
      <aside
        class="hidden xl:block sticky top-[calc(var(--ec-header-offset)+0.25rem)] self-start w-[280px] max-h-[calc(100vh-var(--ec-header-offset)-0.25rem)] overflow-y-auto py-2 flex-shrink-0 pr-4 bg-[rgb(var(--ec-page-bg))]"
        data-pagefind-ignore
      >
        <div class="mt-8 space-y-8">
          <OnThisPage headings={headings} />
        </div>
      </aside>
    </div>
  </main>
</VerticalSideBarLayout>

<style>
  .docs-layout .prose {
    max-width: none;
  }
</style>
