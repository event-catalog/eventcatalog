---
import { buildUrl } from '@utils/url-builder';
import { startStudio } from '../server/runtime';
import { getSignedInUser, isSignedIn } from '../server/sign-in';

export const prerender = false;

// A new canvas. From the New canvas dialog (a POST) it's started with its name and who started it (whoever's signed in,
// or the name they gave); a plain link starts an untitled one, created when its page connects.
const MAX_TITLE_LENGTH = 200;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (field: string) =>
    String(form.get(field) ?? '')
      .trim()
      .slice(0, MAX_TITLE_LENGTH) || undefined;
  const createdBy = getSignedInUser(Astro.locals)?.name ?? text('by');
  const canvasId = await (await startStudio({ isSignedIn })).createCanvas({ title: text('title'), createdBy });
  return Astro.redirect(buildUrl(`/studio/${canvasId}`), 303);
}

return Astro.redirect(buildUrl(`/studio/${crypto.randomUUID()}`));
---
