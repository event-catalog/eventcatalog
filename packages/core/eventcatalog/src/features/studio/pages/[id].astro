---
// Visualiser styles ship in the page head so ClientRouter navigations keep them (see NodeGraph.astro).
import '@eventcatalog/visualiser/styles-core.css';
import '../studio.css';
import VerticalSideBarLayout from '@layouts/VerticalSideBarLayout.astro';
import { buildUrl } from '@utils/url-builder';
import StudioDesigner from '../components/StudioDesigner';
import { getCatalogResources } from '../catalog-resources';
import { startStudio, STUDIO_SOCKET_PATH } from '../server/runtime';
import { getSignedInUser, isSignedIn } from '../server/sign-in';

export const prerender = false;

const { id } = Astro.params;

if (!id || !/^[0-9a-f-]{36}$/i.test(id)) {
  return Astro.redirect(buildUrl('/studio'));
}

const { resources, relations } = await getCatalogResources();
const keptInMemory = (await startStudio({ isSignedIn })).storage.type === 'memory';
const signedInAs = getSignedInUser(Astro.locals);
---

<VerticalSideBarLayout title="Studio - EventCatalog" showNestedSideBar={false}>
  <main
    class="min-h-0 overflow-hidden bg-[rgb(var(--ec-page-bg))]"
    style="margin-left: calc(var(--ec-app-content-padding-left, 5rem) * -1); margin-right: calc(var(--ec-app-content-padding-right, 5rem) * -1); height: calc(100dvh - 60px);"
  >
    <StudioDesigner
      client:only="react"
      canvasId={id}
      socketPath={buildUrl(STUDIO_SOCKET_PATH, true)}
      newCanvasUrl={`${buildUrl('/studio')}?new=1`}
      mcpUrl={buildUrl('/docs/mcp', true)}
      relayScriptPath={buildUrl('/webmcp-relay/embed.js', true)}
      keptInMemory={keptInMemory}
      signedInAs={signedInAs}
      resources={resources}
      relations={relations}
    />
  </main>
</VerticalSideBarLayout>
