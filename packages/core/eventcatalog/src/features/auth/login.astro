---
import BaseLayout from '@layouts/BaseLayout.astro';
import config from '@config';
import { isAuthEnabled, isSSR } from '@utils/feature';
import { buildUrl } from '@utils/url-builder';
import { getSession } from '@utils/auth-astro/server';
import { importCatalogModule } from '@utils/catalog-modules';
import { getOidcProviderName } from '@features/auth/oidc';
import '@fontsource/inter';
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';
import '../../styles/tailwind.css';
import '../../styles/theme.css';
import '../../styles/themes/ocean.css';
import '../../styles/themes/sapphire.css';
import '../../styles/themes/sunset.css';
import '../../styles/themes/forest.css';

/**
 * The sign-in page. A page of its own, outside the app's header and sidebar, in the catalog's theme and with its logo,
 * like the 404 page: monochrome, a faint grid behind it, and one button per provider in eventcatalog.auth.js
 */

// The catalog's own styles (eventcatalog.styles.css), as every other page has them
try {
  await import('@catalog/styles');
} catch {}

// Without a server or with auth off there's nothing to sign in to
if (!isSSR() || !isAuthEnabled()) {
  return Astro.redirect('/');
}

// Already signed in
if (await getSession(Astro.request)) {
  return Astro.redirect('/');
}

let providers: string[] = [];
let oidcProviderName = getOidcProviderName();

try {
  const authConfig = await importCatalogModule('eventcatalog.auth.js');
  providers = Object.keys(authConfig.default.providers ?? {});
  oidcProviderName = getOidcProviderName(authConfig.default.providers?.oidc);
} catch {}

// Icons follow the page's text colour, apart from the logos that are only recognisable in their own colours
const providerConfig: Record<string, { name: string; icon: string }> = {
  github: {
    name: 'GitHub',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
  },
  google: {
    name: 'Google',
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>`,
  },
  okta: {
    name: 'Okta',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.389 0 0 5.389 0 12s5.389 12 12 12 12-5.389 12-12S18.611 0 12 0zm0 18c-3.314 0-6-2.686-6-6s2.686-6 6-6 6 2.686 6 6-2.686 6-6 6z"/></svg>`,
  },
  auth0: {
    name: 'Auth0',
    icon: `<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M12.549 1h-4.55l1.407 4.38h4.548l-3.68 2.61 1.406 4.405c2.37-1.725 3.143-4.336 2.274-7.016L12.55 1zM2.045 5.38h4.55L8 1H3.45L2.045 5.38c-.868 2.68-.094 5.29 2.275 7.015L5.725 7.99l-3.68-2.612zm2.275 7.015L8 15l3.68-2.605L8 9.745l-3.68 2.65z"/></svg>`,
  },
  entra: {
    name: 'Microsoft',
    icon: `<svg viewBox="0 0 21 21" aria-hidden="true"><rect x="1" y="1" width="9" height="9" fill="#F25022"/><rect x="11" y="1" width="9" height="9" fill="#7FBA00"/><rect x="1" y="11" width="9" height="9" fill="#00A4EF"/><rect x="11" y="11" width="9" height="9" fill="#FFB900"/></svg>`,
  },
  // Any other OpenID Connect provider, named by the catalog (e.g. JumpCloud)
  oidc: {
    name: oidcProviderName,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></svg>`,
  },
};

// The providers this page has a button for, in the order eventcatalog.auth.js lists them
const buttons = providers
  .filter((provider) => providerConfig[provider])
  .map((provider) => ({
    provider,
    // Auth.js's id for Microsoft Entra ID differs from its key in eventcatalog.auth.js
    providerId: provider === 'entra' ? 'microsoft-entra-id' : provider,
    ...providerConfig[provider],
  }));

// EventCatalog's mark for the footer, inline (from public/favicon.svg) so it follows the theme and a catalog's own
// favicon can't replace it
const eventCatalogLogo = `<svg viewBox="58 54 1133 1133" fill="currentColor" aria-hidden="true" class="ec-login-footer-logo"><path fill-rule="evenodd" d="M 445 55 c -174.6 0.5 -188.1 0.7 -196.5 2.3 -20.7 4.1 -35.3 8.5 -51 15.3 -66.7 28.8 -114.7 86.9 -130.3 157.9 l -2.6 12 -0.4 371 c -0.2 261 0 373.8 0.8 380.5 4.6 40.7 21.8 79.6 49.8 113 36.8 43.9 89.5 72.4 144.2 77.9 5.9 0.6 148.2 1.1 372.5 1.3 345.2 0.3 363.5 0.2 373 -1.5 32.1 -5.7 58.7 -16.4 85.5 -34.2 53.2 -35.3 89.1 -93.6 96 -156 0.8 -7.2 1 -114.8 0.8 -381.5 l -0.3 -371.5 -2.2 -10.4 c -7.7 -35.9 -18.8 -61.1 -38.9 -88.2 -9.5 -12.8 -30.7 -34.1 -43.4 -43.5 -34.4 -25.6 -73.7 -40.9 -113.5 -44.3 -12.5 -1.1 -182.7 -1.1 -543.5 -0.1 z m -26.3 152.5 c 30.7 11.6 86.7 67 122.9 121.6 l 8.4 12.6 9.7 -2.3 c 13.3 -3.3 30.3 -6.1 44.8 -7.5 15.1 -1.5 51.8 -0.6 67.5 1.6 10.1 1.4 37.1 6.8 40.5 8.1 0.7 0.3 3.6 -3.4 7.1 -8.8 18.3 -29.1 37.9 -53.5 64.7 -80.7 31.8 -32.2 53.3 -47 68.5 -47.1 10.5 -0 16.2 4.1 22.3 16.1 11.6 23 17.3 80.8 15 153.1 l -1 33.7 6 14.7 c 3.2 8 7.8 20.4 10 27.5 2.3 7.1 4.5 12.9 4.9 12.9 0.4 -0 5 -1.5 10.1 -3.4 29.8 -10.8 61.4 -20.5 89.6 -27.5 20 -5.1 21.5 -5.1 25.9 -0.7 2.9 2.9 3.4 4.1 3.4 7.9 0 3.4 -0.6 5.3 -2.5 7.5 -2.9 3.5 -4.7 4.3 -18 7.7 -23.9 6.3 -83.7 25.2 -103 32.5 -2 0.8 -2 1.2 -1 10.6 0.5 5.3 1.5 9.9 2 10 0.6 0.2 16.8 2.4 36 4.9 69.6 9.1 85.9 11.5 89.4 13.3 10.1 5.1 7.6 20.4 -3.6 21.9 -3.7 0.5 -26.4 -2.1 -63.3 -7.2 -18.4 -2.6 -56.7 -7.5 -58 -7.5 -0.4 -0 -1 0.8 -1.2 1.8 -0.4 1.4 -2.9 2.3 -11.4 4.1 -50.2 10.3 -130.1 33.1 -167.9 47.8 -35.1 13.6 -69.4 33.4 -96.1 55.6 -6.6 5.4 -10.1 7.7 -10.9 7.1 -0.7 -0.5 -5.8 -4.6 -11.5 -9.2 -25 -20.2 -55.1 -37.5 -88.5 -50.7 -39.3 -15.6 -111.9 -36.5 -170.7 -49.1 -15.1 -3.2 -17.8 -4.1 -17.8 -5.6 0 -2.4 0.4 -2.4 -35 2.2 -16.8 2.2 -42.6 5.7 -57.5 7.6 -14.8 2 -28.8 3.3 -31 3 -5.9 -0.7 -9.5 -5.1 -9.5 -11.5 0 -5.7 2.4 -9.4 7.3 -11 3.2 -1.1 62.2 -9.4 103.2 -14.6 11.6 -1.5 21.3 -3 21.7 -3.3 0.3 -0.4 0.9 -5 1.3 -10.3 l 0.7 -9.6 -30.3 -10.1 c -24.9 -8.3 -73.2 -22.8 -85.2 -25.6 -1.5 -0.4 -4.1 -1.9 -5.8 -3.4 -2.6 -2.3 -3.3 -3.8 -3.7 -8 -0.4 -4.7 -0.2 -5.4 2.5 -8.1 1.7 -1.6 4.3 -3.3 5.8 -3.7 5.8 -1.4 46 9.3 88.5 23.7 16.2 5.5 30.3 10.3 31.2 10.6 1 0.3 2 -0.1 2.2 -0.8 4.6 -14.9 9 -27.2 14 -39.4 l 6.2 -15 -1 -32.5 c -1.5 -48.5 0.9 -93.8 6.4 -122.4 5 -25.8 12 -40.4 21.9 -45.6 5.4 -2.9 15.3 -2.6 23.8 0.5 z m -67.6 364.4 c 81.9 16.7 161.5 40.4 199.3 59.3 11.7 5.9 29.8 16.7 34.1 20.3 l 3 2.6 -9.5 -0.4 c -8.7 -0.4 -15.5 -2.1 -78.5 -19.7 -37.9 -10.6 -76 -21.2 -84.5 -23.5 -56.6 -15.7 -123.4 -34.6 -123.8 -35 -0.6 -0.6 13.5 -2.8 37.3 -5.8 6.4 -0.8 8.6 -0.6 22.6 2.2 z m 589.5 -0.4 c 10.4 1.4 20.4 2.8 22.3 3.2 3.4 0.6 -40.5 13.5 -170.9 50.2 -20.1 5.7 -42.6 12 -50 14.1 -50.1 14.2 -53.5 15 -60.8 15 -4 -0 -7.2 -0.3 -7.2 -0.8 0 -2.1 28.9 -19.2 45.8 -27.1 36.1 -16.7 110.6 -38.3 193.2 -55.9 6.6 -1.4 7.1 -1.4 27.6 1.3 z m -672.2 33.1 c 13.2 3.6 31.1 8.5 39.6 10.9 8.5 2.4 35.3 9.8 59.5 16.4 52.5 14.3 120.5 33 167.5 46.1 22.9 6.3 23.5 6.6 24.9 9.6 0.8 1.8 1.1 45.6 1.1 162.2 0 175.7 0.4 164.2 -5.9 164.2 -1.5 -0 -12.4 -2.7 -24.2 -6.1 -20.6 -5.8 -66.3 -18.6 -188.9 -52.7 -31.6 -8.8 -63.1 -17.5 -70 -19.2 -13 -3.3 -16.3 -4.8 -17.9 -7.8 -1.1 -2.1 -7.2 -104.7 -15.6 -262.7 -1.3 -25.9 -2.7 -50.5 -3.1 -54.7 -0.6 -7.3 -0.5 -7.8 2 -10.2 1.4 -1.5 3.5 -2.6 4.7 -2.6 1.2 -0 13 3 26.3 6.6 z m 748.1 -5.6 c 3.9 1.5 4.4 4.2 3.4 19.5 -0.8 12.4 -4.2 70.9 -15 256 -2.6 46 -3.3 53.3 -4.8 55.5 -1.9 2.6 1.3 1.6 -78.6 23.9 -9.9 2.8 -34.2 9.6 -54 15.1 -19.8 5.6 -50.4 14.1 -68 19 -17.6 4.9 -45.7 12.8 -62.5 17.5 -16.7 4.7 -31.7 8.5 -33.2 8.5 -6.3 -0 -5.9 11.3 -5.6 -165.1 0.2 -88.2 0.7 -161.2 1.2 -162.1 0.9 -1.9 4.6 -3.1 32.6 -10.7 10.2 -2.8 25.9 -7.1 35 -9.6 9.1 -2.5 32 -8.9 51 -14.1 47.4 -13.1 124.2 -34.5 168.5 -46.9 14.3 -4 26.3 -7.4 26.7 -7.4 0.4 -0.1 1.8 0.3 3.3 0.9 z m -351.7 95.3 c 0.9 0.7 1.2 35.1 1.2 166.7 l 0 165.9 -2.2 1.3 c -1.8 1 -10.2 1.3 -35.1 1.3 -31.4 -0 -32.9 -0.1 -34.3 -1.9 -2.1 -2.9 -2.1 -330.7 0 -332.8 1.1 -1.2 7.6 -1.4 35.2 -1.4 18.7 0.1 34.5 0.5 35.2 0.9 z"/></svg>`;

const homeHref = buildUrl(config.landingPage || '/');
const logoSrc = config?.logo?.src ? buildUrl('/' + config.logo.src.replace(/^\/+/, ''), true) : buildUrl('/logo.png', true);
const logoAlt = config?.logo?.alt || 'EventCatalog';
const catalogName = config?.logo?.text || config?.organizationName || config?.title || 'EventCatalog';
---

<BaseLayout title="Sign in">
  <div class="ec-login" data-login data-home={homeHref}>
    <div class="ec-login-grid-bg" aria-hidden="true"></div>

    <header class="ec-login-top">
      <span class="ec-login-brand">
        <img src={logoSrc} alt={logoAlt} class="h-6 w-6" />
        <span>{catalogName}</span>
      </span>
    </header>

    <main class="ec-login-main">
      {
        buttons.length > 0 ? (
          <div class="ec-login-panel">
            <h1 class="ec-login-title">Sign in to {catalogName}</h1>
            <p class="ec-login-lead">Use your organization's account to continue.</p>

            <div class="ec-login-providers" data-single={String(buttons.length === 1)}>
              {buttons.map((button) => (
                <button type="button" class="ec-login-button" data-provider={button.providerId}>
                  <span class="ec-login-button-icon" set:html={button.icon} />
                  <span class="ec-login-button-label">Continue with {button.name}</span>
                  <span class="ec-login-button-pending" aria-hidden="true">
                    <span class="ec-login-spinner" />
                    Redirecting to {button.name}…
                  </span>
                </button>
              ))}
            </div>

            <p class="ec-login-note" data-login-error role="alert" hidden>
              Couldn't start signing in. Try again, or ask the catalog's admin if it keeps happening.
            </p>
          </div>
        ) : (
          <div class="ec-login-panel ec-login-panel--wide">
            <p class="ec-login-eyebrow">Sign-in isn't set up</p>
            <h1 class="ec-login-title">No sign-in providers</h1>
            <p class="ec-login-lead">
              Authentication is on, but <code>eventcatalog.auth.js</code> has no providers, so there's no way to sign in yet.
            </p>

            <pre class="ec-login-code">
              <code>{`export default {
  providers: {
    github: {
      clientId: process.env.AUTH_GITHUB_CLIENT_ID,
      clientSecret: process.env.AUTH_GITHUB_CLIENT_SECRET,
    },
  },
};`}</code>
            </pre>
            <p class="ec-login-hint">
              Add GitHub, Google, Okta, Auth0, Microsoft Entra ID or any OpenID Connect provider, then restart the server.
            </p>

            <div class="ec-login-actions">
              <a
                href="https://www.eventcatalog.dev/docs/development/authentication/introduction"
                target="_blank"
                rel="noopener noreferrer"
                class="ec-login-link ec-login-link--primary"
              >
                Read the docs
              </a>
              <a href={homeHref} class="ec-login-link">
                Back to home
              </a>
            </div>
          </div>
        )
      }
    </main>

    <footer class="ec-login-footer">
      <a href="https://www.eventcatalog.dev" target="_blank" rel="noopener noreferrer" class="ec-login-footer-link">
        <Fragment set:html={eventCatalogLogo} />
        <span>EventCatalog</span>
      </a>
    </footer>
  </div>
</BaseLayout>

<script>
  import { signIn } from '@utils/auth-astro/client';

  // Where to go once signed in: the page that sent the reader here (?callbackUrl=), so they land where they were going.
  // Only a path on this site, never another origin
  const callbackUrl = () => {
    const requested = new URLSearchParams(window.location.search).get('callbackUrl');
    return requested && requested.startsWith('/') && !requested.startsWith('//') ? requested : undefined;
  };

  const page = document.querySelector<HTMLElement>('[data-login]');
  const error = page?.querySelector<HTMLElement>('[data-login-error]');
  const buttons = Array.from(page?.querySelectorAll<HTMLButtonElement>('[data-provider]') ?? []);

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      const providerId = button.dataset.provider;
      if (!providerId) return;

      // The provider's page takes a moment to open: show which one is on its way, and stop a second click
      buttons.forEach((other) => (other.disabled = true));
      button.dataset.pending = 'true';
      if (error) error.hidden = true;

      try {
        await signIn(providerId, { callbackUrl: callbackUrl() ?? page?.dataset.home ?? '/' });
      } catch {
        buttons.forEach((other) => (other.disabled = false));
        delete button.dataset.pending;
        if (error) error.hidden = false;
      }
    });
  });

  // Coming back to this page from the provider (the back button) shouldn't leave the buttons stuck on "Redirecting"
  window.addEventListener('pageshow', () => {
    buttons.forEach((button) => {
      button.disabled = false;
      delete button.dataset.pending;
    });
  });
</script>

<style is:global>
  /*
   * Like Vercel's sign-in: the catalog's logo at the top, one narrow column in the middle over a faint grid, and a
   * full width button per provider. Monochrome like the rest of the catalog, all from the theme's variables, so it works
   * light, dark and in custom themes
   */
  .ec-login {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    flex-direction: column;
    overflow: hidden;
    background: rgb(var(--ec-page-bg));
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: rgb(var(--ec-page-text));
    -webkit-font-smoothing: antialiased;
    --ec-login-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --ec-login-line: rgb(var(--ec-page-border));
  }
  .ec-login [hidden] {
    display: none !important;
  }
  .ec-login-grid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(var(--ec-page-border) / 0.8) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--ec-page-border) / 0.8) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center center;
    mask-image: radial-gradient(55% 50% at 50% 45%, #000 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(55% 50% at 50% 45%, #000 10%, transparent 75%);
  }

  .ec-login-top {
    display: flex;
    align-items: center;
    padding: 1.25rem 1.5rem;
  }
  @media (min-width: 768px) {
    .ec-login-top {
      padding: 1.5rem 2.5rem;
    }
  }
  .ec-login-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgb(var(--ec-page-text));
  }

  .ec-login-main {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem 5rem;
  }
  .ec-login-panel {
    width: 100%;
    max-width: 22rem;
    text-align: center;
  }
  .ec-login-panel--wide {
    max-width: 30rem;
  }
  .ec-login-eyebrow {
    margin-bottom: 0.75rem;
    font-family: var(--ec-login-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--ec-page-text-muted));
  }
  .ec-login-title {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: rgb(var(--ec-page-text));
  }
  @media (min-width: 768px) {
    .ec-login-title {
      font-size: 2rem;
    }
  }
  .ec-login-lead {
    margin-top: 0.75rem;
    font-size: 15px;
    line-height: 1.6;
    text-wrap: balance;
    color: rgb(var(--ec-page-text-muted));
  }
  .ec-login-lead code,
  .ec-login-hint code {
    padding: 1px 5px;
    border: 1px solid var(--ec-login-line);
    border-radius: 4px;
    background: rgb(var(--ec-page-text) / 0.04);
    font-family: var(--ec-login-mono);
    font-size: 12px;
  }

  /* One button per provider, the same width, stacked */
  .ec-login-providers {
    display: grid;
    gap: 0.625rem;
    margin-top: 2rem;
  }
  .ec-login-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--ec-login-line);
    border-radius: 6px;
    background: rgb(var(--ec-card-bg, var(--ec-page-bg)));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    font-size: 14px;
    font-weight: 500;
    color: rgb(var(--ec-page-text));
    cursor: pointer;
    transition:
      border-color 150ms,
      background-color 150ms,
      opacity 150ms;
  }
  .ec-login-button:hover:not(:disabled) {
    border-color: rgb(var(--ec-page-text) / 0.25);
    background: rgb(var(--ec-page-text) / 0.03);
  }
