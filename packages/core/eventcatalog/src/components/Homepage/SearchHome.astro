---
import { buildUrl } from '@utils/url-builder';
import { isEventCatalogChatEnabled } from '@utils/feature';
import { getCatalogOverview } from '@utils/homepage-dashboard';
import config from '@config';
import { Boxes, FileCode, Search, Server, UsersRound, Waypoints, Zap } from 'lucide-react';

interface Props {
  /** A link to the docs on customizing the homepage: on the default homepage only, not on one that's been customized */
  customizeLink?: boolean;
}

const { customizeLink = false } = Astro.props;

/** The default homepage: search first. One search box that finds a resource or asks the assistant, then the catalog by type */

// Above the title, as the header names the catalog
const catalogName = config?.organizationName || config?.title || 'EventCatalog';

const { counts } = await getCatalogOverview();
// The assistant (asking from the search box) only shows when it's set up and running
const chatEnabled = isEventCatalogChatEnabled();

const types = [
  {
    label: 'Domains',
    count: counts.domains,
    description: 'Business areas and their boundaries',
    href: buildUrl('/discover/domains'),
    icon: Boxes,
  },
  {
    label: 'Services',
    count: counts.services,
    description: 'What runs, and who owns it',
    href: buildUrl('/discover/services'),
    icon: Server,
  },
  {
    label: 'Messages',
    count: counts.messages,
    description: 'Events, commands and queries',
    href: buildUrl('/discover/events'),
    icon: Zap,
  },
  {
    label: 'Flows',
    count: counts.flows,
    description: 'Business processes, step by step',
    href: buildUrl('/discover/flows'),
    icon: Waypoints,
  },
  {
    label: 'Schemas',
    count: counts.schemas,
    description: 'Contracts and API specs',
    href: buildUrl('/schemas/explorer'),
    icon: FileCode,
  },
  {
    label: 'Teams',
    count: counts.teams,
    description: 'Who to ask about what',
    href: buildUrl('/directory/teams'),
    icon: UsersRound,
  },
  // Only the types the catalog has any of
].filter((type) => type.count > 0);
---

<!-- data-search-home: the header changes for it (see Header.astro) -->
<div class="ec-search-home" data-search-home>
  <section class="ec-search-home-hero">
    <div class="ec-search-home-grid-bg" aria-hidden="true"></div>
    <div class="ec-search-home-inner">
      <p class="ec-search-home-eyebrow">{catalogName}</p>
      <h1 class="ec-search-home-title">What are you looking for?</h1>
      <p class="ec-search-home-lead">Search everything documented across your architecture.</p>

      <form class="ec-search-home-box" data-home-search data-mode="find" role="search">
        <div class="flex items-center gap-3 px-4">
          <Search className="h-4 w-4 shrink-0 text-[rgb(var(--ec-page-text-muted))]" aria-hidden="true" />
          <label for="home-search" class="sr-only">
            {chatEnabled ? 'Search the catalog or ask a question' : 'Search the catalog'}
          </label>
          <input
            id="home-search"
            type="text"
            autocomplete="off"
            data-find-placeholder={`Search services, events, schemas, teams${chatEnabled ? ', or ask a question' : ''}`}
            data-ask-placeholder="Ask a question about the architecture"
            placeholder={`Search services, events, schemas, teams${chatEnabled ? ', or ask a question' : ''}`}
            class="h-12 min-w-0 flex-1 border-0 bg-transparent p-0 text-[15px] text-[rgb(var(--ec-page-text))] outline-none placeholder:text-[rgb(var(--ec-page-text-muted)/0.55)] focus:ring-0"
          />
          <kbd class="ec-search-home-kbd">⌘K</kbd>
        </div>
        {
          chatEnabled && (
            <div class="flex flex-wrap items-center gap-3 border-t border-[rgb(var(--ec-page-border))] px-3 py-2.5">
              <div class="ec-search-home-segmented" role="group" aria-label="Search or ask">
                <button type="button" data-mode-button="find" aria-pressed="true">
                  Find a resource
                </button>
                <button type="button" data-mode-button="ask" aria-pressed="false">
                  Ask AI
                </button>
              </div>
            </div>
          )
        }
      </form>
    </div>
  </section>

  {
    types.length > 0 && (
      <section class="ec-search-home-browse" aria-labelledby="home-browse">
        <div class="ec-search-home-inner">
          <p class="ec-search-home-eyebrow">Browse</p>
          <h2 id="home-browse" class="ec-search-home-heading">
            Browse by type
          </h2>
        </div>
        <nav class="ec-search-home-types" aria-labelledby="home-browse">
          {types.map((type) => (
            <a href={type.href}>
              <span class="ec-search-home-types-top">
                <span class="ec-search-home-types-chip" aria-hidden="true">
                  <type.icon className="ec-search-home-types-icon" />
                </span>
                <span class="ec-search-home-types-name">{type.label}</span>
                <span class="ec-search-home-types-arrow" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="ec-search-home-types-count">{type.count}</span>
              <span class="ec-search-home-types-description">{type.description}</span>
            </a>
          ))}
        </nav>
      </section>
    )
  }

  {
    customizeLink && (
      <a
        href="https://www.eventcatalog.dev/docs/development/customization/customize-landing-page"
        target="_blank"
        rel="noopener noreferrer"
        class="ec-search-home-customize"
      >
        Customize this page
      </a>
    )
  }
</div>

<script>
  const openSearch = (query?: string) => (window as any).searchModalState?.open(query);
  const ask = (question: string) => window.dispatchEvent(new CustomEvent('eventcatalog:open-chat', { detail: { question } }));

  const bind = () => {
    const form = document.querySelector<HTMLFormElement>('[data-home-search]');
    const input = form?.querySelector<HTMLInputElement>('#home-search');
    if (!form || !input || form.dataset.bound) return;
    form.dataset.bound = 'true';

    const setMode = (mode: 'find' | 'ask') => {
      form.dataset.mode = mode;
      input.placeholder = (mode === 'ask' ? input.dataset.askPlaceholder : input.dataset.findPlaceholder) ?? '';
      form.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.modeButton === mode));
      });
      input.focus();
    };
    form.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach((button) => {
      button.addEventListener('click', () => setMode(button.dataset.modeButton as 'find' | 'ask'));
    });

    // Finding a resource hands over to the catalog's search as soon as there's something to search for
    const handOverToSearch = () => {
      const query = input.value;
      input.value = '';
      openSearch(query);
    };
    input.addEventListener('input', () => {
      if (form.dataset.mode === 'find' && input.value.trim()) handOverToSearch();
    });
    input.addEventListener('click', () => {
      if (form.dataset.mode === 'find') handOverToSearch();
    });

    // Enter asks the assistant (or searches)
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (form.dataset.mode === 'ask') {
        if (!text) return;
        input.value = '';
        ask(text);
      } else {
        handOverToSearch();
      }
    });
  };
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style is:global>
  /*
   * Monochrome, like Vercel: full width sections divided by hairlines, a faint grid fading out behind the hero and the
   * types in a grid of cells edge to edge. Everything from the theme's variables, so it works light, dark and in custom
   * themes
   */
  .ec-search-home {
    isolation: isolate;
    font-size: 14px;
    line-height: 1.5;
    color: rgb(var(--ec-page-text));
    -webkit-font-smoothing: antialiased;
    --ec-search-home-search: 44rem;
    --ec-search-home-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    --ec-search-home-line: rgb(var(--ec-page-border));
    /* How far the content sits in from the edge */
    --ec-search-home-gutter: 2rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 768px) {
    .ec-search-home {
      --ec-search-home-gutter: 3rem;
    }
  }
  @media (min-width: 1280px) {
    .ec-search-home {
      --ec-search-home-gutter: 4rem;
    }
  }
  /* On the default homepage, edge to edge of the content area (out over the page's padding), so the lines between the
     sections run the full width. In a custom homepage it stays in its column */
  .app-content-wrapper > .ec-search-home {
    margin-left: calc(-1 * var(--ec-app-content-padding-left, 0px));
    margin-right: calc(-1 * var(--ec-app-content-padding-right, 0px));
  }
  /* Each section closed off along its bottom */
  .ec-search-home-hero,
  .ec-search-home-browse {
    position: relative;
    border-bottom: 1px solid var(--ec-search-home-line);
  }
  .ec-search-home-inner {
    position: relative;
    padding-left: var(--ec-search-home-gutter);
    padding-right: var(--ec-search-home-gutter);
  }
  /* A small label above a heading: mono, uppercase */
  .ec-search-home-eyebrow {
    font-family: var(--ec-search-home-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--ec-page-text-muted));
  }

  /* The hero */
  .ec-search-home-hero > .ec-search-home-inner {
    padding-top: 2.5rem;
    padding-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .ec-search-home-hero > .ec-search-home-inner {
      padding-top: 3.5rem;
      padding-bottom: 4rem;
    }
  }
  .ec-search-home-grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(var(--ec-page-border) / 0.7) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--ec-page-border) / 0.7) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: -1px -1px;
    mask-image: radial-gradient(70% 90% at 20% 0%, #000 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(70% 90% at 20% 0%, #000 20%, transparent 70%);
  }
  .ec-search-home-title {
    margin-top: 0.875rem;
    max-width: 48rem;
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
    color: rgb(var(--ec-page-text));
  }
  @media (min-width: 768px) {
    .ec-search-home-title {
      font-size: 3rem;
    }
  }
  .ec-search-home-lead {
    margin-top: 1rem;
    max-width: 40rem;
    font-size: 17px;
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: rgb(var(--ec-page-text-muted));
  }
  .ec-search-home-box {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--ec-search-home-search);
    margin-top: 2rem;
    border: 1px solid var(--ec-search-home-line);
    border-radius: 6px;
    background: rgb(var(--ec-card-bg, var(--ec-page-bg)));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    transition:
      border-color 150ms,
      box-shadow 150ms;
  }
  .ec-search-home-box:hover {
    border-color: rgb(var(--ec-page-text) / 0.25);
  }
  .ec-search-home-box:focus-within {
    border-color: rgb(var(--ec-page-text) / 0.45);
    box-shadow: 0 0 0 3px rgb(var(--ec-page-text) / 0.08);
  }
  .ec-search-home-kbd {
    flex: none;
    padding: 1px 6px;
    border: 1px solid var(--ec-search-home-line);
    border-radius: 4px;
    background: rgb(var(--ec-page-text) / 0.04);
    font-family: var(--ec-search-home-mono);
    font-size: 11px;
    color: rgb(var(--ec-page-text-muted));
  }
  .ec-search-home-segmented {
    display: inline-flex;
    padding: 2px;
    gap: 2px;
    border: 1px solid var(--ec-search-home-line);
    border-radius: 6px;
    background: rgb(var(--ec-page-bg));
  }
  .ec-search-home-segmented button {
    height: 1.75rem;
    padding: 0 0.625rem;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
    color: rgb(var(--ec-page-text-muted));
    transition:
      background-color 150ms,
      color 150ms;
  }
  .ec-search-home-segmented button:hover {
    color: rgb(var(--ec-page-text));
  }
  .ec-search-home-segmented button[aria-pressed='true'] {
    background: rgb(var(--ec-page-text));
    color: rgb(var(--ec-page-bg));
  }

  /*
   * Browse by type: the heading, then one cell per type edge to edge. Each cell draws the lines on its
   * right and bottom, and the grid clips the ones along its outside edges, so a part-filled last row still lines up
   */
  .ec-search-home-browse {
    /* Columns by the room it has (the sidebar takes some), not the window's width */
    container-type: inline-size;
  }
  .ec-search-home-browse > .ec-search-home-inner {
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
  }
  .ec-search-home-heading {
    margin-top: 0.5rem;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
    color: rgb(var(--ec-page-text));
  }
  .ec-search-home-types {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-top: 1px solid var(--ec-search-home-line);
  }
  @container (min-width: 520px) {
    .ec-search-home-types {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container (min-width: 880px) {
    .ec-search-home-types {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ec-search-home-types a {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 1.5rem var(--ec-search-home-gutter);
    box-shadow:
      1px 0 0 0 var(--ec-search-home-line),
      0 1px 0 0 var(--ec-search-home-line);
    transition: background-color 150ms;
  }
  .ec-search-home-types a:hover,
  .ec-search-home-types a:focus-visible {
    background: rgb(var(--ec-page-text) / 0.03);
  }
  .ec-search-home-types-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ec-search-home-types-chip {
    width: 28px;
    height: 28px;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ec-search-home-line);
    border-radius: 6px;
    background: rgb(var(--ec-page-bg));
    color: rgb(var(--ec-page-text));
  }
  .ec-search-home-types-icon {
    width: 14px;
    height: 14px;
  }
  .ec-search-home-types-name {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgb(var(--ec-page-text));
  }
  /* Comes in from the left on hover */
  .ec-search-home-types-arrow {
    flex: none;
    color: rgb(var(--ec-page-text-muted));
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 150ms,
      transform 150ms;
  }
  .ec-search-home-types a:hover .ec-search-home-types-arrow,
  .ec-search-home-types a:focus-visible .ec-search-home-types-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .ec-search-home-types-count {
    margin-top: 1.25rem;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--ec-page-text));
  }
  .ec-search-home-types-description {
    margin-top: 0.5rem;
    font-size: 13px;
    line-height: 1.5;
    color: rgb(var(--ec-page-text-muted));
  }

  /* Bottom right of the screen, and quiet: no fill until it's hovered */
  .ec-search-home-customize {
    position: fixed;
    z-index: 20;
    right: calc(1.25rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    font-size: 12px;
    font-weight: 400;
    font-style: italic;
    /* Barely there until you look for it: it only comes forward on hover */
    color: rgb(var(--ec-page-text-muted) / 0.45);
    transition:
      color 150ms,
      border-color 150ms,
      background-color 150ms;
  }
  .ec-search-home-customize:hover {
    border-color: rgb(var(--ec-page-border));
    background: rgb(var(--ec-page-bg) / 0.85);
    color: rgb(var(--ec-page-text));
  }
</style>
