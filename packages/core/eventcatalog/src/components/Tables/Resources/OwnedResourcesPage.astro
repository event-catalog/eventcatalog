---
// The Owned Resources page of a team or user: everything they own, in the Resources table.
import VerticalSideBarLayout from '@layouts/VerticalSideBarLayout.astro';
import { ResourcesTable } from '@components/Tables/Resources/ResourcesTable';
import { getSchemaKeys, toResourceItem } from '@components/Tables/Resources/resource-items';
import { getOwnedResources } from '@utils/collections/owned-resources';

interface Props {
  /** A team or user from getTeams / getUsers. */
  owner: { data: { name: string; [key: string]: unknown } };
  description: string;
}

const { owner, description } = Astro.props;

const schemaKeys = await getSchemaKeys();
const resources = getOwnedResources(owner).flatMap(({ collection, items }) =>
  items.map((item) => toResourceItem(collection, item, schemaKeys))
);
const count = `${resources.length} ${resources.length === 1 ? 'resource' : 'resources'}`;
---

<VerticalSideBarLayout title={`${owner.data.name} | Owned Resources`}>
  <style is:global>
    :root[data-embedded='true'] #resources-page {
      height: 100dvh !important;
    }
  </style>
  {/* Same layout as the domain Resources pages: fill the viewport so the table can paginate. */}
  <main
    id="resources-page"
    class="flex h-full min-h-0 flex-col overflow-hidden bg-[rgb(var(--ec-page-bg))]"
    style="margin-left: calc(var(--ec-app-content-padding-left, 5rem) * -1); margin-right: calc(var(--ec-app-content-padding-right, 5rem) * -1); height: calc(100dvh - 60px);"
  >
    <ResourcesTable
      resources={resources}
      title={`${owner.data.name} Owned Resources`}
      description={`${count} ${description}`}
      typeLabels={{ domains: { plural: 'Domains', singular: 'Domain' } }}
      client:only="react"
    />
  </main>
</VerticalSideBarLayout>
