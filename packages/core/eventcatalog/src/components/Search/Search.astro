---
import MagnifyingGlassIcon from '@heroicons/react/24/outline/MagnifyingGlassIcon';
import SearchModal from './SearchModal.tsx';
---

<!-- The homepage has its own search box and hides this one (see Header.astro); ⌘K and the modal still work there --><!-- As Vercel draws it: a compact, lightly tinted field with a hairline border, a short placeholder and one key chip -->
<div data-search-input>
  <div class="group relative flex min-w-0 items-center w-full">
    <input
      id="search-dummy-input"
      type="text"
      name="search"
      placeholder="Search..."
      autocomplete="off"
      class="block h-8 min-w-0 w-full cursor-pointer rounded-md caret-transparent border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-text)/0.025)] py-0 pl-8! pr-12 text-[13px] font-normal text-[rgb(var(--ec-header-text))] placeholder:text-[rgb(var(--ec-page-text-muted))] outline-hidden transition-colors hover:border-[rgb(var(--ec-page-text)/0.2)] hover:bg-[rgb(var(--ec-page-text)/0.04)] focus-visible:ring-2 focus-visible:ring-[rgb(var(--ec-accent)/0.35)]"
    />
    <MagnifyingGlassIcon
      className="pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[rgb(var(--ec-page-text-muted))]"
    />
    <kbd
      class="pointer-events-none absolute right-1.5 top-1/2 -translate-y-1/2 inline-flex h-5 items-center rounded border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-1.5 font-sans text-[11px] font-medium tracking-wide text-[rgb(var(--ec-page-text-muted))]"
      >⌘K</kbd
    >
  </div>
</div>

<SearchModal client:idle />

<script>
  // Create a global state for the search modal
  (window as any).searchModalState = {
    isOpen: false,
    isClosing: false,
    // Opens the modal, with what to search for when it's given (e.g. typed into the homepage's search box)
    open: function (query?: string) {
      if (this.isClosing) return;
      this.isOpen = true;
      this.render(query);
    },
    toggle: function () {
      if (this.isClosing) return;
      this.isOpen = !this.isOpen;
      this.render();
    },
    close: function () {
      this.isOpen = false;
      this.isClosing = true;
      this.render();
      // Reset isClosing after a short delay to prevent immediate reopening by focus restoration
      // waiting for transition (200ms) + buffer
      setTimeout(() => {
        this.isClosing = false;
      }, 500);
    },
    render: function (query?: string) {
      // This will be handled by React component
      const event = new CustomEvent('searchModalToggle', {
        detail: { isOpen: this.isOpen, query },
      });
      window.dispatchEvent(event);
    },
  };

  // Setup function to initialize event listeners
  function setupSearchListeners() {
    const dummyInput = document.getElementById('search-dummy-input');

    // Remove existing listeners if any to prevent duplicates
    if (dummyInput) {
      const newInput = dummyInput.cloneNode(true) as HTMLElement;
      dummyInput.parentNode?.replaceChild(newInput, dummyInput);
      const refreshedInput = document.getElementById('search-dummy-input');

      refreshedInput?.addEventListener('click', function (e) {
        e.preventDefault();
        this.blur();
        (window as any).searchModalState.open();
      });

      refreshedInput?.addEventListener('focus', function (e) {
        e.preventDefault();
        this.blur();
        (window as any).searchModalState.open();
      });
    }
  }

  // Setup keyboard shortcut (only needs to be done once)
  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
      event.preventDefault();
      (window as any).searchModalState.open();
    }
  });

  // Listen for modal state changes to update page elements
  window.addEventListener('searchModalToggle', (event) => {
    const header = document.getElementById('eventcatalog-header');
    const verticalNav = document.getElementById('eventcatalog-vertical-nav');
    // Handle custom docs sidebars
    const customDocsSidebars = document.querySelectorAll('aside[class*="fixed"][class*="z-10"]');

    if ((event as any).detail.isOpen) {
      if (header) header.classList.remove('backdrop-blur-sm');
      if (verticalNav) verticalNav.style.zIndex = '-100';
      // Hide custom docs sidebars when modal opens
      customDocsSidebars.forEach((sidebar: any) => {
        sidebar.style.zIndex = '-100';
      });
    } else {
      if (header) header.classList.add('backdrop-blur-sm');
      if (verticalNav) verticalNav.style.zIndex = '10';
      // Restore custom docs sidebars when modal closes
      customDocsSidebars.forEach((sidebar: any) => {
        sidebar.style.zIndex = '10';
      });
    }
  });

  // Setup listeners on initial load
  setupSearchListeners();

  // Re-setup listeners after client-side navigation
  document.addEventListener('astro:page-load', setupSearchListeners);
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
