---
/**
 * Shown on a previous version of a page: what you're looking at, and a link to its latest version.
 * The sentences come from getVersionBannerText, so the spaces in them can't be lost when the markup is reformatted.
 */
import Admonition from '@components/MDX/Admonition';
import { getVersionBannerText } from '@utils/version-banner';

interface Props {
  /** What this page is a version of, e.g. "service" or "service doc" */
  subject: string;
  /** Its name */
  name: string;
  /** What the link goes to the latest version of, e.g. "service", "GraphQL schema" or "doc" */
  latestOf: string;
  latestVersion: string;
  href: string;
}

const { subject, name, latestOf, latestVersion, href } = Astro.props;
const text = getVersionBannerText({ subject, latestOf });
---

<Admonition type="warning" title="New version found">
  <p>
    {text.previous}<strong>{name}</strong>.{' '}
    <a class="underline block pt-2" href={href}>
      {text.latest}<span>v{latestVersion}</span> &rarr;
    </a>
  </p>
</Admonition>
