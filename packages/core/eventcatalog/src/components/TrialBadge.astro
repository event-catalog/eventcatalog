---
import { getLicenseNotice } from '@utils/license-notice';

const notice = await getLicenseNotice(Astro.url);
---

{
  /*
   * While a trial runs: quiet text in the header with the days left, linking to the license settings. When something needs doing (the license has
   * expired or is expiring, or the trial has ended) the banner across the top says so instead (LicenseBanner.astro)
   */
  notice && !notice.warning && (
    <a
      href={notice.href}
      title={notice.message}
      class="whitespace-nowrap text-xs font-medium text-[rgb(var(--ec-page-text-muted))] underline-offset-4 transition-colors hover:text-[rgb(var(--ec-page-text))] hover:underline"
    >
      {notice.label}
    </a>
  )
}
