---
import catalog from '@utils/eventcatalog-config/catalog';
import { isDevMode } from '@utils/feature';
import { getLicenseDaysLeft, getTrialStatus, LICENSE_FAQ_URL, TRIAL_LENGTH_DAYS } from '@utils/trial';
import { getLicenseStatus } from '@utils/license';
import { buildUrl } from '@utils/url-builder';

// Only shown while running `eventcatalog dev`, never in built or served catalogs.
// A valid license.jwt replaces the trial, and only shows once it's about to expire.
// An expired license.jwt shows instead of the trial. A Scale or Starter plan replaces the trial too.
const license = isDevMode() ? await getLicenseStatus() : undefined;
const licensedUntil = license?.state === 'licensed' ? license.expiresAt : undefined;
const licenseDaysLeft = licensedUntil ? getLicenseDaysLeft(licensedUntil) : undefined;
const licenseExpired = license?.state === 'expired';
const expiredOn = license?.state === 'expired' ? license.expiresAt : undefined;
const trial =
  isDevMode() && !licensedUntil && !licenseExpired && license?.state !== 'plan' ? getTrialStatus(catalog?.tsd) : undefined;

const days = (count?: number) => `${count} ${count === 1 ? 'day' : 'days'}`;
const label = licenseExpired
  ? 'License expired'
  : licenseDaysLeft !== undefined
    ? `License · ${days(licenseDaysLeft)} left`
    : trial?.ended
      ? 'Trial ended'
      : `Trial · ${days(trial?.daysLeft)} left`;
const title = licenseExpired
  ? `Your EventCatalog commercial license ${expiredOn ? `expired on ${expiredOn.toLocaleDateString()}` : 'has expired'}. Renew it to keep using EventCatalog commercially.`
  : licenseDaysLeft !== undefined
    ? `Your EventCatalog commercial license expires on ${licensedUntil?.toLocaleDateString()}. Renew it to keep using EventCatalog commercially.`
    : trial?.ended
      ? `Your ${TRIAL_LENGTH_DAYS}-day EventCatalog trial ended on ${trial.endsAt.toLocaleDateString()}. Learn about licensing.`
      : `You're on a ${TRIAL_LENGTH_DAYS}-day EventCatalog trial, ending on ${trial?.endsAt.toLocaleDateString()}. Learn about licensing.`;
const warning = licenseExpired || licenseDaysLeft !== undefined || trial?.ended;
// An expiring or expired license opens the license settings (where it's renewed), the trial the license FAQ
const isLicense = licenseExpired || licenseDaysLeft !== undefined;
const href = isLicense ? buildUrl('/settings/license') : LICENSE_FAQ_URL;
---

{
  (licenseExpired || licenseDaysLeft !== undefined || trial) && (
    <a
      href={href}
      target={isLicense ? undefined : '_blank'}
      rel={isLicense ? undefined : 'noopener noreferrer'}
      title={title}
      data-trial-ended={trial?.ended ? 'true' : undefined}
      data-license-expired={licenseExpired ? 'true' : undefined}
      class:list={[
        'inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-medium transition-colors',
        warning
          ? 'border-[rgb(var(--ec-badge-color-amber-text)/0.3)] bg-[rgb(var(--ec-badge-color-amber-background))] text-[rgb(var(--ec-badge-color-amber-text))] hover:opacity-90'
          : 'border-[rgb(var(--ec-accent)/0.3)] bg-[rgb(var(--ec-accent-subtle))] text-[rgb(var(--ec-accent))] hover:bg-[rgb(var(--ec-accent)/0.15)]',
      ]}
    >
      <svg
        viewBox="0 0 24 24"
        class="h-3.5 w-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        {licenseExpired ? (
          <>
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
          </>
        ) : (
          <>
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </>
        )}
      </svg>
      {label}
    </a>
  )
}
