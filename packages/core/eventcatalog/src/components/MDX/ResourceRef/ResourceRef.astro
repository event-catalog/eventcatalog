---
/**
 * Inline resource reference component with hover tooltip.
 *
 * Usage via remark plugin:
 * [[service|OrderService]] -> Links to OrderService with tooltip
 * [[Order]] -> Shorthand, defaults to entity type
 */
import { buildUrl } from '@utils/url-builder';
import {
  getItemsFromCollectionByIdAndSemverOrLatest,
  resourceToCollectionMap,
  getDeprecatedDetails,
} from '@utils/collections/util';
import { getCollection } from 'astro:content';
import { getServiceSpecifications, getSpecUrl, getSpecLabel } from '@components/Grids/specification-utils';
import { getResourceReferenceStyle } from '@utils/resource-reference-colors';
import { getResourceReferenceIcon } from '@utils/resource-reference-icons';
import { isIconPath, resolveIconUrl } from '@utils/icon';
import {
  getResourceReferenceUrl,
  isVersionedReference,
  resolveMessageReference,
  resolveOwnerReference,
} from '@utils/resource-reference-links';

interface Props {
  type:
    | 'agent'
    | 'entity'
    | 'service'
    | 'event'
    | 'command'
    | 'query'
    | 'domain'
    | 'flow'
    | 'channel'
    | 'diagram'
    | 'container'
    | 'system'
    | 'user'
    | 'team'
    | 'doc'
    | 'adr'
    | 'data-product';
  version?: string;
}

const { type = 'entity', version } = Astro.props;

// Get resource ID from slot content
const slotContent = await Astro.slots.render('default');
const resourceId = slotContent.trim();

const normalizeCustomDocPath = (value: string): string => {
  const normalized = value
    .trim()
    .replace(/^https?:\/\/[^/]+/i, '')
    .replace(/\\/g, '/');
  return normalized
    .replace(/^\/+/, '')
    .replace(/^docs\/custom\//i, '')
    .replace(/^docs\//i, '')
    .replace(/\/+$/, '');
};

const normalizedResourceId = normalizeCustomDocPath(resourceId).toLowerCase();

// Map type to collection name
const collection = resourceToCollectionMap[type as keyof typeof resourceToCollectionMap];

const typeLabels: Record<string, string> = {
  agent: 'Agent',
  entity: 'Entity',
  service: 'Service',
  event: 'Event',
  command: 'Command',
  query: 'Query',
  domain: 'Domain',
  flow: 'Flow',
  channel: 'Channel',
  diagram: 'Diagram',
  container: 'Container',
  system: 'System',
  user: 'User',
  team: 'Team',
  doc: 'Custom Doc',
  adr: 'Decision Record',
  'data-product': 'Data Product',
};

const label = typeLabels[type] || typeLabels.entity;
const iconPath = getResourceReferenceIcon(type);
const resourceReferenceStyle = getResourceReferenceStyle(type);

let resource: any = null;
let href = '#';
let hasError = false;
let errorMessage = '';

try {
  if (type === 'doc') {
    const docs = (await getCollection('customPages')) as {
      id: string;
      data: { title?: string; summary?: string; slug?: string; owners?: any[] };
    }[];

    const doc = docs.find((entry) => {
      const normalizedId = normalizeCustomDocPath(entry.id).toLowerCase();
      const normalizedSlug = normalizeCustomDocPath(entry.data.slug || '').toLowerCase();

      return normalizedId === normalizedResourceId || normalizedSlug === normalizedResourceId;
    });

    if (!doc) {
      throw new Error(`Document not found: ${resourceId}`);
    }

    const docSlug = normalizeCustomDocPath(doc.data.slug || doc.id);
    href = buildUrl(`/docs/custom/${docSlug}`);
    resource = {
      ...doc,
      data: {
        ...doc.data,
        name: doc.data.title || docSlug,
      },
    };
  } else {
    if (!collection) {
      throw new Error(`Unknown resource type: ${type}`);
    }

    const resourcesCollection = (await getCollection(collection as any)) as { data: { id: string; version: string } }[];
    const resources = isVersionedReference(collection)
      ? getItemsFromCollectionByIdAndSemverOrLatest(resourcesCollection, resourceId, version)
      : resourcesCollection.filter((item) => item.data.id === resourceId);

    if (resources.length === 0) {
      throw new Error(`Resource not found: ${resourceId}`);
    }

    resource = resources[0];
    href = getResourceReferenceUrl(collection, resourceId, resource.data.version);
  }
} catch (error) {
  hasError = true;
  errorMessage = error instanceof Error ? error.message : 'Unknown error';
}

// Truncate summary if too long
const maxSummaryLength = 120;
const summary = resource?.data?.summary || '';
const truncatedSummary = summary.length > maxSummaryLength ? summary.slice(0, maxSummaryLength) + '...' : summary;

const isVersionedResource = type !== 'doc' && isVersionedReference(collection);

// Only these types have visualizers
const hasVisualizer = ['agent', 'domain', 'service', 'event', 'query', 'command', 'container', 'system'].includes(type);

// Check deprecation status
const deprecation = resource ? getDeprecatedDetails(resource) : null;
const isDeprecated = deprecation?.isMarkedAsDeprecated || false;
const resourceIconUrl = isIconPath(resource?.data?.styles?.icon) ? resolveIconUrl(resource.data.styles.icon) : null;

// Get owners (first 2)
const owners = await Promise.all((resource?.data?.owners?.slice(0, 2) || []).map(resolveOwnerReference));

// Check if message type has a schema
const isMessageType = ['event', 'command', 'query'].includes(type);
const hasSchema = isMessageType && resource?.data?.schemaPath;

// Check if resource has a repository URL
const repositoryUrl = resource?.data?.repository?.url;

// For services: get messages (sends/receives) with resolved versions
const maxMessages = 3;
const sends = resource?.data?.sends || [];
const receives = resource?.data?.receives || [];
const isService = type === 'service' || type === 'agent';
const supportsSpecifications = type === 'service';

// Resolve versions and collections for messages to show
const sendsWithVersions = await Promise.all(
  sends.slice(0, maxMessages).map(async (msg: any) => {
    const resolved = await resolveMessageReference(msg);
    return { ...msg, resolvedVersion: resolved.version, resolvedCollection: resolved.collection };
  })
);
const receivesWithVersions = await Promise.all(
  receives.slice(0, maxMessages).map(async (msg: any) => {
    const resolved = await resolveMessageReference(msg);
    return { ...msg, resolvedVersion: resolved.version, resolvedCollection: resolved.collection };
  })
);

// Get specifications for services
const specifications = supportsSpecifications ? getServiceSpecifications(resource?.data) : [];
const hasSpecifications = specifications.length > 0;

// Generate unique ID for this instance
const tooltipId = `ref-tooltip-${Math.random().toString(36).slice(2, 9)}`;
---

<span class="resource-ref-wrapper inline relative">
  {
    hasError ? (
      <span
        class="text-[rgb(var(--ec-page-text-muted))] underline decoration-wavy decoration-red-400/50 underline-offset-2 cursor-help"
        title={`Reference not found: ${resourceId}`}
      >
        {resourceId}
      </span>
    ) : (
      <>
        <a
          href={href}
          class:list={[
            'resource-ref-trigger inline-flex items-center gap-1 px-1 -mx-1 rounded font-medium underline decoration-dotted decoration-1 underline-offset-[3px] transition-colors',
            'text-[var(--ec-resource-ref-color)] decoration-[var(--ec-resource-ref-decoration)] hover:bg-[var(--ec-resource-ref-bg)]',
          ]}
          style={resourceReferenceStyle}
          data-tooltip-id={tooltipId}
        >
          <svg
            class="w-3.5 h-3.5 flex-shrink-0 text-[var(--ec-resource-ref-color)]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            set:html={iconPath}
          />
          <span>
            {resource?.data?.name || resourceId}
            {isDeprecated && ' (deprecated)'}
          </span>
        </a>
        {/* The hover card, as Vercel's: what it is (a mono line with its type and version), its name and summary, what
            it's connected to, then where to go (the other views as small buttons, its docs as the main one). Out of the
            prose styles (not-prose), so its links stay quiet; the details line up in two columns */}
        <span
          id={tooltipId}
          class="resource-ref-tooltip not-prose fixed z-[9999] w-80 overflow-hidden rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg,var(--ec-page-bg)))] text-left opacity-0 shadow-[0_4px_8px_-4px_rgb(0_0_0/0.06),0_16px_32px_-8px_rgb(0_0_0/0.14)] pointer-events-none transition-all duration-150 scale-95 origin-top-left"
          style={resourceReferenceStyle}
        >
          <span class="block px-4 pt-3.5 pb-3.5">
            {/* What it is: its icon on a chip in its colour, its type in mono, then its version (and if it's deprecated) */}
            <span class="flex items-center gap-2">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-[5px] bg-[var(--ec-resource-ref-bg)]"
                aria-hidden="true"
              >
                {resourceIconUrl ? (
                  <img
                    src={resourceIconUrl}
                    alt=""
                    class="ec-mono-icon ec-mono-icon--active m-0 block h-3 w-3 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <svg
                    class="h-3 w-3"
                    style="color: var(--ec-resource-ref-color);"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    set:html={iconPath}
                  />
                )}
              </span>
              <span class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-[rgb(var(--ec-page-text-muted))]">
                {label}
              </span>
              <span class="ml-auto flex items-center gap-1.5">
                {isDeprecated && (
                  <span class="rounded-[4px] border border-[rgb(var(--ec-badge-color-red-text)/0.4)] px-1.5 font-mono text-[10px] uppercase leading-[18px] text-[rgb(var(--ec-badge-color-red-text))]">
                    Deprecated
                  </span>
                )}
                {isVersionedResource && (
                  <span class="rounded-[4px] border border-[rgb(var(--ec-page-border))] px-1.5 font-mono text-[10px] leading-[18px] text-[rgb(var(--ec-page-text-muted))]">
                    v{resource?.data?.version}
                  </span>
                )}
              </span>
            </span>

            {/* Its name */}
            <span
              class:list={[
                'mt-2.5 block truncate text-[15px] font-semibold leading-5 tracking-[-0.02em] text-[rgb(var(--ec-page-text))]',
                isDeprecated && 'line-through decoration-[rgb(var(--ec-page-text-muted))]',
              ]}
            >
              {resource?.data?.name || resourceId}
            </span>

            {truncatedSummary && (
              <span class="mt-1.5 block text-[13px] leading-relaxed text-[rgb(var(--ec-page-text-muted))]">
                {truncatedSummary}
              </span>
            )}

            {/* The details, labels in one column and values in the next */}
            {(isService && (sends.length > 0 || receives.length > 0)) || hasSpecifications || owners.length > 0 ? (
              <span class="mt-3.5 grid grid-cols-[4.5rem_minmax(0,1fr)] items-baseline gap-x-3 gap-y-2 border-t border-[rgb(var(--ec-page-border))] pt-3.5 text-xs leading-5">
                {isService && sends.length > 0 && (
                  <>
                    <span class="text-[rgb(var(--ec-page-text-muted))]">Publishes</span>
                    <span class="break-words text-[rgb(var(--ec-page-text))]">
                      {sendsWithVersions.slice(0, 2).map((msg: any, idx: number) => (
                        <>
                          {msg.resolvedVersion && msg.resolvedCollection ? (
                            <a
                              href={buildUrl(`/docs/${msg.resolvedCollection}/${msg.id}/${msg.resolvedVersion}`)}
                              class="rounded-sm underline-offset-2 hover:underline hover:decoration-[rgb(var(--ec-page-text-muted))]"
                            >
                              {msg.id}
                            </a>
                          ) : (
                            <span class="text-[rgb(var(--ec-page-text-muted))]">{msg.id}</span>
                          )}
                          {idx < Math.min(sendsWithVersions.length, 2) - 1 && ', '}
                        </>
                      ))}
                      {sends.length > 2 && <span class="text-[rgb(var(--ec-page-text-muted))]"> +{sends.length - 2}</span>}
                    </span>
                  </>
                )}
                {isService && receives.length > 0 && (
                  <>
                    <span class="text-[rgb(var(--ec-page-text-muted))]">Subscribes</span>
                    <span class="break-words text-[rgb(var(--ec-page-text))]">
                      {receivesWithVersions.slice(0, 2).map((msg: any, idx: number) => (
                        <>
                          {msg.resolvedVersion && msg.resolvedCollection ? (
                            <a
                              href={buildUrl(`/docs/${msg.resolvedCollection}/${msg.id}/${msg.resolvedVersion}`)}
                              class="rounded-sm underline-offset-2 hover:underline hover:decoration-[rgb(var(--ec-page-text-muted))]"
                            >
                              {msg.id}
                            </a>
                          ) : (
                            <span class="text-[rgb(var(--ec-page-text-muted))]">{msg.id}</span>
                          )}
                          {idx < Math.min(receivesWithVersions.length, 2) - 1 && ', '}
                        </>
                      ))}
                      {receives.length > 2 && <span class="text-[rgb(var(--ec-page-text-muted))]"> +{receives.length - 2}</span>}
                    </span>
                  </>
                )}
                {hasSpecifications && (
                  <>
                    <span class="text-[rgb(var(--ec-page-text-muted))]">APIs</span>
                    <span class="break-words text-[rgb(var(--ec-page-text))]">
                      {specifications.map((spec: any, idx: number) => (
                        <>
                          <a
                            href={getSpecUrl(spec, resourceId, resource?.data?.version)}
                            class="rounded-sm underline-offset-2 hover:underline hover:decoration-[rgb(var(--ec-page-text-muted))]"
                          >
                            {spec.type === 'generic' && spec.name ? spec.name : getSpecLabel(spec.type)}
                          </a>
                          {idx < specifications.length - 1 && ', '}
                        </>
                      ))}
                    </span>
                  </>
                )}
                {owners.length > 0 && (
                  <>
                    <span class="text-[rgb(var(--ec-page-text-muted))]">{owners.length > 1 ? 'Owners' : 'Owner'}</span>
                    {/* Each owner as a small mono pill */}
                    <span class="flex flex-wrap gap-1">
                      {owners.map((o: any) =>
                        o.href ? (
                          <a
                            href={o.href}
                            class="rounded-[4px] border border-[rgb(var(--ec-page-border))] px-1.5 font-mono text-[11px] leading-[18px] text-[rgb(var(--ec-page-text))] transition-colors hover:bg-[rgb(var(--ec-page-text)/0.05)]"
                          >
                            {o.id}
                          </a>
                        ) : (
                          <span class="rounded-[4px] border border-[rgb(var(--ec-page-border))] px-1.5 font-mono text-[11px] leading-[18px] text-[rgb(var(--ec-page-text))]">
                            {o.id}
                          </span>
                        )
                      )}
                    </span>
                  </>
                )}
              </span>
            ) : null}
          </span>

          {/* Where to go: the other views as small outlined buttons, its docs as the main (filled) one */}
          <span class="flex items-center justify-between gap-2 border-t border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-text)/0.02)] px-4 py-2.5 text-xs">
            <span class="flex flex-wrap items-center gap-1.5">
              {type === 'flow' && (
                <a
                  href={buildUrl(`/visualiser/${collection}/${resourceId}/${resource?.data?.version}`)}
                  class="inline-flex h-6 items-center rounded-md border border-[rgb(var(--ec-page-border))] px-2 font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:bg-[rgb(var(--ec-page-text)/0.05)]"
                >
                  View flow
                </a>
              )}
              {hasSchema && (
                <a
                  href={buildUrl(`/schemas/${collection}/${resourceId}/${resource?.data?.version}`)}
                  class="inline-flex h-6 items-center rounded-md border border-[rgb(var(--ec-page-border))] px-2 font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:bg-[rgb(var(--ec-page-text)/0.05)]"
                >
                  Schema
                </a>
              )}
              {hasVisualizer && type !== 'flow' && (
                <a
                  href={buildUrl(`/visualiser/${collection}/${resourceId}/${resource?.data?.version}`)}
                  class="inline-flex h-6 items-center rounded-md border border-[rgb(var(--ec-page-border))] px-2 font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:bg-[rgb(var(--ec-page-text)/0.05)]"
                >
                  Diagram
                </a>
              )}
              {repositoryUrl && (
                <a
                  href={repositoryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-6 items-center rounded-md border border-[rgb(var(--ec-page-border))] px-2 font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:bg-[rgb(var(--ec-page-text)/0.05)]"
                >
                  Repository
                </a>
              )}
            </span>
            <a
              href={href}
              class="inline-flex h-6 shrink-0 items-center gap-1 rounded-md bg-[rgb(var(--ec-page-text))] px-2.5 font-medium text-[rgb(var(--ec-page-bg))] transition-opacity hover:opacity-85"
            >
              {type === 'diagram' ? 'Open diagram' : type === 'doc' ? 'Open doc' : 'Open docs'}
              <span aria-hidden="true">→</span>
            </a>
          </span>
        </span>
      </>
    )
  }
</span>

<script>
  // Initialize all resource ref tooltips
  function initResourceRefTooltips() {
    const triggers = document.querySelectorAll('.resource-ref-trigger');

    triggers.forEach((trigger) => {
      const tooltipId = trigger.getAttribute('data-tooltip-id');
      if (!tooltipId) return;

      const tooltip = document.getElementById(tooltipId);
      if (!tooltip) return;

      let hideTimeout: ReturnType<typeof setTimeout>;

      const showTooltip = () => {
        clearTimeout(hideTimeout);

        // Get trigger position
        const rect = trigger.getBoundingClientRect();
        const tooltipWidth = 320; // w-80 = 20rem = 320px
        const padding = 16;

        // Calculate left position - try to align with trigger, but keep within viewport
        let left = rect.left;

        // If tooltip would overflow right edge, align to right edge of viewport
        if (left + tooltipWidth > window.innerWidth - padding) {
          left = window.innerWidth - tooltipWidth - padding;
        }

        // If tooltip would overflow left edge, align to left edge
        if (left < padding) {
          left = padding;
        }

        // Position below the trigger
        const top = rect.bottom + 8;

        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${top}px`;
        tooltip.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
        tooltip.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
      };

      const hideTooltip = () => {
        hideTimeout = setTimeout(() => {
          tooltip.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
          tooltip.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
        }, 100);
      };

      const keepTooltipOpen = () => {
        clearTimeout(hideTimeout);
      };

      // Trigger events
      trigger.addEventListener('mouseenter', showTooltip);
      trigger.addEventListener('mouseleave', hideTooltip);
      trigger.addEventListener('focus', showTooltip);
      trigger.addEventListener('blur', hideTooltip);

      // Tooltip events - keep open when hovering tooltip
      tooltip.addEventListener('mouseenter', keepTooltipOpen);
      tooltip.addEventListener('mouseleave', hideTooltip);
    });
  }

  // Run on initial load
  initResourceRefTooltips();

  // Re-run after Astro page transitions
  document.addEventListener('astro:page-load', initResourceRefTooltips);
</script>
