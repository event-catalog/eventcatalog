---
import { getBadgeHref, getBadgeTint } from '@utils/badge-styles';
import { ArrowTopRightOnSquareIcon } from '@heroicons/react/20/solid';

type Badge = {
  id?: string;
  content: string;
  backgroundColor?: string;
  textColor?: string;
  icon?: any;
  iconComponent?: any;
  iconURL?: string;
  iconURLLight?: string;
  iconURLDark?: string;
  class?: string;
  url?: string;
};

type Props = {
  badge?: Badge | null;
  className?: string;
};

const { badge, className = '' } = Astro.props;
const href = badge ? getBadgeHref(badge) : undefined;
// Only links that leave the catalog get the external-link arrow.
const isExternalHref = !!href && (/^[a-z][a-z0-9+.-]*:/i.test(href) || href.startsWith('//'));
const Icon = badge?.icon || badge?.iconComponent;
const hasThemedIcon = Boolean(badge?.iconURLLight && badge?.iconURLDark);
const badgeId = badge?.id || undefined;
const content = badge?.content ?? '';
const iconURL = badge?.iconURL;
const iconURLLight = badge?.iconURLLight;
const iconURLDark = badge?.iconURLDark;
// A neutral chip with a hairline border; a tag's colour is its accent: a small dot before the name, or its icon
// tinted. The text stays the page's, so tags read the same in every theme and don't clash side by side
const tint = getBadgeTint(badge);
const style = tint ? `--ec-badge-tint: ${tint};` : '';
const hasImage = hasThemedIcon || !!iconURL;
const showDot = !!tint && !Icon && !hasImage;
const classes = `
  ec-badge ${tint ? 'ec-badge--tinted' : ''} ${href ? 'ec-badge--link' : ''}
  ${badge?.class ? badge.class : ''}
  ${className}
`;
---

{
  badge &&
    (href ? (
      <a id={badgeId} href={href} class={classes} style={style} title={content}>
        {showDot && <span class="ec-badge-dot" aria-hidden="true" />}
        {Icon && <Icon className="ec-badge-icon" aria-hidden="true" />}
        {hasThemedIcon && <img src={iconURLLight} class="ec-badge-img dark:hidden" alt="" onerror="this.style.display='none'" />}
        {hasThemedIcon && (
          <img src={iconURLDark} class="ec-badge-img hidden dark:inline-block" alt="" onerror="this.style.display='none'" />
        )}
        {!hasThemedIcon && iconURL && <img src={iconURL} class="ec-badge-img" alt="" onerror="this.style.display='none'" />}
        <span>{content}</span>
        {isExternalHref && <ArrowTopRightOnSquareIcon className="w-2.5 h-2.5 flex-shrink-0 opacity-70" aria-hidden="true" />}
      </a>
    ) : (
      <span id={badgeId} class={classes} style={style} title={content}>
        {showDot && <span class="ec-badge-dot" aria-hidden="true" />}
        {Icon && <Icon className="ec-badge-icon" aria-hidden="true" />}
        {hasThemedIcon && <img src={iconURLLight} class="ec-badge-img dark:hidden" alt="" onerror="this.style.display='none'" />}
        {hasThemedIcon && (
          <img src={iconURLDark} class="ec-badge-img hidden dark:inline-block" alt="" onerror="this.style.display='none'" />
        )}
        {!hasThemedIcon && iconURL && <img src={iconURL} class="ec-badge-img" alt="" onerror="this.style.display='none'" />}
        <span>{content}</span>
      </span>
    ))
}

<style is:global>
  .ec-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 22px;
    padding: 0 8px;
    border: 1px solid rgb(var(--ec-page-border));
    border-radius: 6px;
    background: rgb(var(--ec-page-bg));
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: rgb(var(--ec-page-text) / 0.85);
    transition:
      border-color 150ms,
      background-color 150ms,
      color 150ms;
  }
  .ec-badge-dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 999px;
    background: var(--ec-badge-tint);
  }
  .ec-badge-icon,
  .ec-badge-img {
    width: 12px;
    height: 12px;
    flex: none;
  }
  .ec-badge-icon {
    color: var(--ec-badge-tint, rgb(var(--ec-page-text-muted)));
  }
  .ec-badge-img {
    object-fit: contain;
  }
  .ec-badge--link:hover {
    border-color: rgb(var(--ec-page-text) / 0.25);
    background: rgb(var(--ec-page-text) / 0.04);
    color: rgb(var(--ec-page-text));
  }
</style>
