---
import VerticalSideBarLayout from './VerticalSideBarLayout.astro';
import { buildUrl } from '@utils/url-builder';
import { Settings, Server, Bot, ScanText, BadgeCheck } from 'lucide-react';

export type SettingsSection = 'general' | 'mcp' | 'assistant' | 'llm-access' | 'license';

interface Props {
  title: string;
  active: SettingsSection;
}

const { title, active } = Astro.props;

interface SectionItem {
  id: SettingsSection;
  label: string;
  href: string;
  icon: any;
}

interface SectionGroup {
  label: string;
  items: SectionItem[];
}

const groups: SectionGroup[] = [
  {
    label: 'Project Settings',
    items: [
      {
        id: 'general',
        label: 'General',
        href: buildUrl('/settings/general'),
        icon: Settings,
      },
    ],
  },
  {
    label: 'AI Settings',
    items: [
      {
        id: 'mcp',
        label: 'MCP',
        href: buildUrl('/settings/mcp'),
        icon: Server,
      },
      {
        id: 'assistant',
        label: 'Agent',
        href: buildUrl('/settings/assistant'),
        icon: Bot,
      },
      {
        id: 'llm-access',
        label: 'LLM Access',
        href: buildUrl('/settings/llm-access'),
        icon: ScanText,
      },
    ],
  },
  {
    label: 'Workspace',
    items: [
      {
        id: 'license',
        label: 'License',
        href: buildUrl('/settings/license'),
        icon: BadgeCheck,
      },
    ],
  },
];
---

<VerticalSideBarLayout title={`${title} | Settings`} showNestedSideBar={true}>
  <Fragment slot="sidebar-content">
    <div class="settings-rail flex h-full flex-col bg-[rgb(var(--ec-rail-bg))]">
      <nav class="flex flex-1 flex-col gap-6 overflow-y-auto px-3 pt-6 pb-4">
        {
          groups.map((group) => (
            <div class="space-y-1">
              <p class="rail-section-label px-3 pb-1 text-[12px] font-medium text-[rgb(var(--ec-page-text-muted))]">
                {group.label}
              </p>
              <div class="flex flex-col gap-0.5">
                {group.items.map((item) => {
                  const isActive = item.id === active;
                  return (
                    <a
                      href={item.href}
                      aria-current={isActive ? 'page' : undefined}
                      class:list={[
                        // As in Vercel's settings: the page you're on on a neutral grey, the rest muted until hovered
                        'nav-secondary-item flex items-center gap-2.5 rounded-md px-3 py-2 text-[13px] transition-colors duration-150',
                        isActive
                          ? 'bg-[rgb(var(--ec-page-text)/0.06)] font-medium text-[rgb(var(--ec-page-text))]'
                          : 'text-[rgb(var(--ec-page-text-muted))] hover:bg-[rgb(var(--ec-page-text)/0.04)] hover:text-[rgb(var(--ec-page-text))]',
                      ]}
                    >
                      <item.icon className="h-3.5 w-3.5 flex-shrink-0" aria-hidden="true" />
                      <span class="nav-item-label">{item.label}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          ))
        }
      </nav>
    </div>
  </Fragment>

  <div class="settings-page w-full max-w-5xl px-8 py-10">
    <h1 class="mb-8 text-[28px] font-semibold leading-tight tracking-[-0.035em] text-[rgb(var(--ec-page-text))]">{title}</h1>
    <slot />
  </div>
</VerticalSideBarLayout>
