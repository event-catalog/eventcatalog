---
import SEO from '../components/Seo.astro';
import AnalyticsHead from '../features/analytics/components/AnalyticsHead.astro';
import AnalyticsTracker from '../features/analytics/components/AnalyticsTracker.astro';
import NavigationProgress from '../components/NavigationProgress.astro';
import config from '@config';
import { isLLMSTxtEnabled } from '@utils/feature';
import { getMarkdownPathForPage } from '@utils/markdown-pages';
import { getColorMode } from '@utils/color-mode';

interface Props {
  /** The page's own title; the catalog's title follows it (the homepage has none) */
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const catalogTheme = config.theme || 'default';
// Also set on <html>, for the theme store (stores/theme-store.ts)
const colorMode = getColorMode(config);
// Lets agents find the page's Markdown (llms.txt links to the same URLs)
const markdownPath = isLLMSTxtEnabled() ? getMarkdownPathForPage(Astro.url.pathname, import.meta.env.BASE_URL) : null;
---

<!doctype html>
<html
  lang="en"
  data-catalog-theme={catalogTheme}
  data-color-mode={colorMode.default}
  data-color-mode-toggle={String(colorMode.allowToggle)}
>
  <head>
    <!-- Inline script to prevent flash of wrong theme -->
    <script is:inline define:vars={{ catalogTheme, colorMode }}>
      (function () {
        function getDefaultTheme() {
          if (colorMode.default !== 'system') return colorMode.default;
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }

        function getStoredTheme() {
          // With the toggle hidden, a choice the visitor saved before doesn't apply
          if (!colorMode.allowToggle) return null;
          try {
            const stored = localStorage.getItem('eventcatalog-theme');
            return stored === 'light' || stored === 'dark' ? stored : null;
          } catch (e) {
            return null;
          }
        }

        function getEmbeddedTheme() {
          const params = new URLSearchParams(window.location.search);
          const requestedTheme = params.get('theme');
          const embedded = params.get('embed') === 'true';
          return embedded && (requestedTheme === 'light' || requestedTheme === 'dark') ? requestedTheme : null;
        }

        function applyTheme() {
          // An embed can request its own theme without changing the user's saved catalog preference.
          const theme = getEmbeddedTheme() || getStoredTheme() || getDefaultTheme();
          document.documentElement.setAttribute('data-theme', theme);
          // Also ensure catalog theme is set (for page transitions)
          document.documentElement.setAttribute('data-catalog-theme', catalogTheme);
        }

        // Apply on initial load
        applyTheme();

        // Follow the system as it changes. Here rather than only in the theme store, which isn't loaded on pages
        // without the header toggle (allowToggle: false). A saved choice still wins (applyTheme checks it)
        if (colorMode.default === 'system' && window.matchMedia) {
          window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', applyTheme);
        }

        // The ClientRouter swaps <html>'s attributes for the incoming page's, which doesn't have the theme (it's set
        // here). Give it the current one first, so nothing is drawn without a theme mid-navigation
        document.addEventListener('astro:before-swap', (event) => {
          const nextRoot = event.newDocument.documentElement;
          for (const name of ['data-theme', 'data-catalog-theme']) {
            const value = document.documentElement.getAttribute(name);
            if (value && !nextRoot.hasAttribute(name)) nextRoot.setAttribute(name, value);
          }
        });

        // Apply after Astro page transitions
        document.addEventListener('astro:after-swap', applyTheme);
        document.addEventListener('astro:page-load', applyTheme);
      })();
    </script>
    <SEO title={title} description={description} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <AnalyticsHead />
    <slot name="head" />
  </head>
  <body>
    <NavigationProgress />
    <slot />
    <AnalyticsTracker />
  </body>
</html>
