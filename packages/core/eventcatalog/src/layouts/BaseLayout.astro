---
import SEO from '../components/Seo.astro';
import AnalyticsHead from '../features/analytics/components/AnalyticsHead.astro';
import AnalyticsTracker from '../features/analytics/components/AnalyticsTracker.astro';
import NavigationProgress from '../components/NavigationProgress.astro';
import config from '@config';

interface Props {
  /** The page's own title; the catalog's title follows it (the homepage has none) */
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const catalogTheme = config.theme || 'default';
---

<!doctype html>
<html lang="en" data-catalog-theme={catalogTheme}>
  <head>
    <!-- Inline script to prevent flash of wrong theme -->
    <script is:inline define:vars={{ catalogTheme }}>
      (function () {
        function getDefaultTheme() {
          return 'dark';
        }

        function getEmbeddedTheme() {
          const params = new URLSearchParams(window.location.search);
          const requestedTheme = params.get('theme');
          const embedded = params.get('embed') === 'true';
          return embedded && (requestedTheme === 'light' || requestedTheme === 'dark') ? requestedTheme : null;
        }

        function applyTheme() {
          // An embed can request its own theme without changing the user's saved catalog preference.
          const embeddedTheme = getEmbeddedTheme();
          const stored = localStorage.getItem('eventcatalog-theme');
          const theme = embeddedTheme || (stored === 'light' || stored === 'dark' ? stored : getDefaultTheme());
          document.documentElement.setAttribute('data-theme', theme);
          // Also ensure catalog theme is set (for page transitions)
          document.documentElement.setAttribute('data-catalog-theme', catalogTheme);
        }

        // Apply on initial load
        applyTheme();

        // The ClientRouter swaps <html>'s attributes for the incoming page's, which doesn't have the theme (it's set
        // here). Give it the current one first, so nothing is drawn without a theme mid-navigation
        document.addEventListener('astro:before-swap', (event) => {
          const nextRoot = event.newDocument.documentElement;
          for (const name of ['data-theme', 'data-catalog-theme']) {
            const value = document.documentElement.getAttribute(name);
            if (value && !nextRoot.hasAttribute(name)) nextRoot.setAttribute(name, value);
          }
        });

        // Apply after Astro page transitions
        document.addEventListener('astro:after-swap', applyTheme);
        document.addEventListener('astro:page-load', applyTheme);
      })();
    </script>
    <SEO title={title} description={description} />
    <AnalyticsHead />
    <slot name="head" />
  </head>
  <body>
    <NavigationProgress />
    <slot />
    <AnalyticsTracker />
  </body>
</html>
