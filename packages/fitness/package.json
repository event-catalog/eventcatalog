{
  "name": "@eventcatalog/fitness",
  "version": "0.1.0",
  "description": "Write architecture fitness functions for EventCatalog and run them locally or in CI",
  "repository": {
    "type": "git",
    "url": "https://github.com/event-catalog/eventcatalog"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:bin": "tsup",
    "test": "vitest --run",
    "test:ci": "vitest --run",
    "format": "prettier --write .",
    "format:diff": "prettier --list-different ."
  },
  "keywords": [
    "eventcatalog",
    "fitness-functions",
    "architecture",
    "event-driven"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@eventcatalog/sdk": "workspace:*",
    "gray-matter": "^4.0.3",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prettier": "^3.3.3",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ]
}
