{
  "name": "@eventcatalog/exporters",
  "version": "0.0.2",
  "description": "Export an EventCatalog to other formats, such as a single-file HTML architecture reference",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:bin": "tsup",
    "test": "vitest --run",
    "test:ci": "vitest --run",
    "format": "prettier --write .",
    "format:diff": "prettier --list-different .",
    "generate:reference": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-reference-locally.mjs"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "@eventcatalog/sdk": "workspace:*",
    "js-yaml": "^4.1.1",
    "marked": "^15.0.6",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10",
    "@types/semver": "^7.5.8",
    "prettier": "^3.3.3",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/event-catalog/eventcatalog"
  }
}
