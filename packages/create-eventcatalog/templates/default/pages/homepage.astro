---
// EventCatalog injects its components via Astro.props.components: this landing page shows the catalog dashboard
// (counts, and the architecture graph). Add your own content below it, or remove this file for the default homepage.
const { CatalogDashboard } = Astro.props.components;
---

<div class="not-prose">
  <CatalogDashboard
    title="Acme Inc Catalog"
    description="Discover, explore and document the event-driven architecture that powers Acme Inc — our domains, the systems inside them, and the services and messages that connect everything."
  />
</div>
